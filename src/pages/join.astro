---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Join the League - Fresh Meat Clinic" description="Join Brookings Area Roller Derby. Skaters, referees, and non-skating officials (NSOs) of all experience levels welcome.">
  
  <!-- Header Banner -->
  <section class="bg-grunge py-14 border-b-4 border-[#541221]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block px-3 py-1 bg-[#3B0B16] text-[#E5A93C] font-heading uppercase text-xs tracking-widest rounded mb-3">
        Recruitment &amp; Clinics
      </span>
      <h1 class="font-heading text-5xl sm:text-7xl uppercase tracking-wider text-white">
        Join the Pack / Fresh Meat
      </h1>
      <p class="text-gray-400 text-lg max-w-2xl mt-2">
        Whether you've never worn skates or you're a seasoned skater looking for a new league, we have a place for you.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">
    
    <!-- Roles Breakdown -->
    <div>
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="font-heading text-4xl sm:text-5xl uppercase tracking-wider text-white mb-3">
          Find Your Role in BARD
        </h2>
        <p class="text-gray-400 text-base">
          Roller derby takes a full village of athletes and officials. Explore how you can participate.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Skaters -->
        <div class="bg-[#1B1B1B] border-2 border-[#541221] p-8 rounded-xl flex flex-col justify-between shadow-xl">
          <div>
            <div class="w-12 h-12 bg-[#3B0B16] text-[#E5A93C] rounded-lg flex items-center justify-center font-heading text-2xl mb-6">
              01
            </div>
            <h3 class="font-heading text-3xl text-white uppercase tracking-wider mb-2">Adult Skaters (18+)</h3>
            <p class="text-xs uppercase font-subheading text-[#E5A93C] mb-4">Adult Division • Full Contact</p>
            <p class="text-sm text-gray-300 leading-relaxed mb-4">
              Train in skating posture, pack strategy, hitting, stopping, and apex jumps. We guide you through safety benchmarks step-by-step until you're ready for inter-league bouts.
            </p>
            <ul class="space-y-1.5 text-xs text-gray-400 mb-6">
              <li>✓ No prior skating experience required</li>
              <li>✓ Loaner safety pads and skates available</li>
              <li>✓ Practice 2x weekly at Outdoor Adventure Center</li>
            </ul>
          </div>
          <span class="text-xs font-heading uppercase text-gray-400 block pt-4 border-t border-[#282828]">All Body Types &amp; Fitness Levels Welcome</span>
        </div>

        <!-- Juniors -->
        <div class="bg-[#1B1B1B] border-2 border-[#541221] p-8 rounded-xl flex flex-col justify-between shadow-xl">
          <div>
            <div class="w-12 h-12 bg-[#3B0B16] text-[#E5A93C] rounded-lg flex items-center justify-center font-heading text-2xl mb-6">
              02
            </div>
            <h3 class="font-heading text-3xl text-white uppercase tracking-wider mb-2">Junior Derby (Ages 8-17)</h3>
            <p class="text-xs uppercase font-subheading text-[#E5A93C] mb-4">Youth League • Level-Based Contact</p>
            <p class="text-sm text-gray-300 leading-relaxed mb-4">
              Build confidence, balance, and leadership in a supportive, fun team environment. Junior skaters learn positional blocking and derby fundamentals safely.
            </p>
            <ul class="space-y-1.5 text-xs text-gray-400 mb-6">
              <li>✓ Mentored by veteran BARD skaters</li>
              <li>✓ Level 1 (Non-contact) to Level 3 progression</li>
              <li>✓ Family-friendly events and junior mixers</li>
            </ul>
          </div>
          <span class="text-xs font-heading uppercase text-gray-400 block pt-4 border-t border-[#282828]">Youth Scholarships Available</span>
        </div>

        <!-- Officials -->
        <div class="bg-[#1B1B1B] border-2 border-[#541221] p-8 rounded-xl flex flex-col justify-between shadow-xl">
          <div>
            <div class="w-12 h-12 bg-[#3B0B16] text-[#E5A93C] rounded-lg flex items-center justify-center font-heading text-2xl mb-6">
              03
            </div>
            <h3 class="font-heading text-3xl text-white uppercase tracking-wider mb-2">Refs &amp; NSOs</h3>
            <p class="text-xs uppercase font-subheading text-[#E5A93C] mb-4">Skating &amp; Non-Skating Officials</p>
            <p class="text-sm text-gray-300 leading-relaxed mb-4">
              Don't want to get tackled, but still want to be in the center of the action? Zebras (skating refs) and NSOs (penalty tracking, scoreboard, jam timing) run every game.
            </p>
            <ul class="space-y-1.5 text-xs text-gray-400 mb-6">
              <li>✓ Best seat in the house for every bout</li>
              <li>✓ No dues or equipment fees for officials</li>
              <li>✓ Full training on WFTDA/MRDA rulesets</li>
            </ul>
          </div>
          <span class="text-xs font-heading uppercase text-gray-400 block pt-4 border-t border-[#282828]">Free Admission &amp; Travel Stipends</span>
        </div>

      </div>
    </div>

    <!-- Inclusivity & Open Gender Policy Statement -->
    <div class="bg-[#3B0B16] border-2 border-[#9E1F3D] rounded-xl p-8 sm:p-10 space-y-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🏳️‍🌈</span>
        <h3 class="font-heading text-2xl sm:text-3xl text-white uppercase tracking-wider">
          Our Inclusivity &amp; Open Gender Policy
        </h3>
      </div>
      <p class="text-gray-200 text-sm sm:text-base leading-relaxed">
        Brookings Area Roller Derby is committed to fostering an open, safe, inclusive, and empowering sports space. We welcome cisgender women, transgender women, intersex individuals, and gender expansive or non-binary participants across our teams. Our officiating, coaching, volunteer, and junior support positions are open to individuals of all genders. Discrimination, racism, and harassment have zero place on our track.
      </p>
    </div>

    <!-- Intake & Contact Form Placeholder -->
    <div class="bg-[#1B1B1B] border-2 border-[#541221] rounded-2xl p-8 sm:p-12">
      <div class="max-w-3xl mx-auto space-y-8">
        
        <div class="text-center">
          <span class="text-xs uppercase font-heading tracking-widest text-[#E5A93C] block mb-1">Get Started Today</span>
          <h2 class="font-heading text-4xl uppercase tracking-wider text-white">Fresh Meat &amp; Volunteer Intake</h2>
          <p class="text-gray-400 text-sm mt-2">
            Fill out this quick form or reach out directly on Facebook. A league coordinator will reach out within 48 hours to invite you to our next practice session!
          </p>
        </div>

        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Thank you for reaching out to BARD! We will follow up with you regarding upcoming practice schedules.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-heading uppercase tracking-wider text-gray-300 mb-2">First &amp; Last Name *</label>
              <input type="text" required placeholder="Jane Doe" class="w-full bg-[#121212] border border-[#3B0B16] focus:border-[#E5A93C] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors" />
            </div>
            <div>
              <label class="block text-xs font-heading uppercase tracking-wider text-gray-300 mb-2">Email Address *</label>
              <input type="email" required placeholder="skater@example.com" class="w-full bg-[#121212] border border-[#3B0B16] focus:border-[#E5A93C] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-heading uppercase tracking-wider text-gray-300 mb-2">Phone Number</label>
              <input type="tel" placeholder="(605) 555-0199" class="w-full bg-[#121212] border border-[#3B0B16] focus:border-[#E5A93C] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors" />
            </div>
            <div>
              <label class="block text-xs font-heading uppercase tracking-wider text-gray-300 mb-2">Area of Interest *</label>
              <select required class="w-full bg-[#121212] border border-[#3B0B16] focus:border-[#E5A93C] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors">
                <option value="adult-skater">Adult Skater (18+)</option>
                <option value="junior-skater">Junior Derby (Ages 8-17)</option>
                <option value="referee">Skating Referee (Zebra)</option>
                <option value="nso">Non-Skating Official (NSO)</option>
                <option value="volunteer">Event Volunteer / Bout Staff</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-heading uppercase tracking-wider text-gray-300 mb-2">Skating Experience / Questions</label>
            <textarea rows="4" placeholder="Tell us if you have any roller skating experience, need loaner gear, or have any specific questions for our coaching staff!" class="w-full bg-[#121212] border border-[#3B0B16] focus:border-[#E5A93C] rounded px-4 py-3 text-white text-sm focus:outline-none transition-colors"></textarea>
          </div>

          <div class="text-center pt-2">
            <button type="submit" class="px-10 py-4 bg-[#9E1F3D] hover:bg-[#7A1A30] text-white font-heading uppercase tracking-wider text-xl rounded shadow-xl border border-white/20 transition-transform active:scale-95">
              Submit Intake Information
            </button>
          </div>
        </form>

        <div class="pt-6 border-t border-[#282828] text-center text-xs text-gray-400">
          Prefer social media? You can also message our recruitment team directly on <a href="https://www.facebook.com/BrookingsAreaRollerDerby" target="_blank" rel="noopener noreferrer" class="text-[#E5A93C] underline font-bold">Facebook</a>.
        </div>

      </div>
    </div>

  </div>
</Layout>
