---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const bouts = await getCollection('bouts');
const sortedBouts = bouts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const events = await getCollection('events');
const sortedEvents = events.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Layout title="2026 Schedule & Bouts" description="Full 2026 Brookings Area Roller Derby schedule including home bouts, away matches, and community appearances.">
  
  <!-- Header Banner -->
  <section class="bg-[#121212] py-14 border-b border-[#252525]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block px-3 py-1 bg-[#541221] text-white font-semibold uppercase text-xs tracking-wider rounded mb-3">
        2026 Season
      </span>
      <h1 class="font-heading text-5xl sm:text-7xl uppercase tracking-wider text-white">
        Bout Schedule &amp; Events
      </h1>
      <p class="text-gray-400 text-base sm:text-lg max-w-2xl mt-2">
        Catch BARD in action on our home track in Brookings, SD or on the road across the upper Midwest.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    
    <!-- Roller Derby Bouts Section -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-3 border-b border-[#252525]">
        <div>
          <h2 class="font-heading text-3xl sm:text-4xl uppercase tracking-wider text-white">
            Competitive Bouts &amp; Tournaments
          </h2>
          <p class="text-gray-400 text-sm">Full contact flat track roller derby games</p>
        </div>
      </div>

      <div class="space-y-5">
        {sortedBouts.map((bout) => {
          const dateObj = new Date(bout.data.date);
          const month = dateObj.toLocaleDateString('en-US', { month: 'short' });
          const day = dateObj.toLocaleDateString('en-US', { day: '2-digit' });
          const year = dateObj.getFullYear();
          const isHome = bout.data.homeOrAway === 'home';

          return (
            <div class={`bg-[#181818] rounded-xl border ${isHome ? 'border-[#541221]' : 'border-[#2A2A2A]'} overflow-hidden shadow-md`}>
              <div class="p-6 flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
                
                <!-- Date Badge -->
                <div class="flex items-center gap-5">
                  <div class={`text-center rounded-lg p-3 w-20 flex-shrink-0 ${isHome ? 'bg-[#541221] text-white' : 'bg-[#222] text-gray-300'}`}>
                    <span class="block text-xs uppercase font-sans font-bold tracking-wider">{month}</span>
                    <span class="block font-heading text-4xl leading-none my-0.5">{day}</span>
                    <span class="block text-[11px] opacity-75 font-mono">{year}</span>
                  </div>

                  <!-- Bout Details -->
                  <div>
                    <div class="flex flex-wrap items-center gap-2 mb-1.5">
                      <span class={`px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider rounded ${isHome ? 'bg-[#541221] text-white' : 'bg-[#282828] text-gray-300'}`}>
                        {isHome ? 'Home Bout' : 'Away Match'}
                      </span>
                      {bout.data.highlight && (
                        <span class="px-2 py-0.5 text-xs font-semibold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded">
                          Doubleheader Feature
                        </span>
                      )}
                    </div>
                    
                    <h3 class="font-heading text-2xl sm:text-3xl text-white uppercase tracking-wider">
                      {bout.data.title}
                    </h3>
                    
                    <p class="text-sm text-gray-400 mt-0.5">
                      Opponent: <span class="text-gray-200 font-medium">{bout.data.opponent}</span>
                    </p>
                  </div>
                </div>

                <!-- Venue & Ticket CTA -->
                <div class="md:text-right flex flex-col md:items-end gap-3 w-full md:w-auto pt-4 md:pt-0 border-t md:border-t-0 border-[#252525]">
                  <div>
                    <p class="text-xs text-gray-400 font-mono">{bout.data.time}</p>
                    <p class="text-sm text-gray-300 font-medium">{bout.data.location}</p>
                  </div>
                  
                  {bout.data.ticketLink ? (
                    <a 
                      href={bout.data.ticketLink} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="inline-block px-5 py-2 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase tracking-wider text-base rounded transition-colors"
                    >
                      Bout Info &amp; Tickets
                    </a>
                  ) : (
                    <span class="text-xs text-gray-400 bg-[#121212] px-3 py-1.5 rounded">
                      Tickets at the Door
                    </span>
                  )}
                </div>

              </div>

              {bout.data.details && (
                <div class="bg-[#141414] px-6 py-3 border-t border-[#252525] text-xs text-gray-400 leading-relaxed">
                  <strong class="text-gray-300">Details:</strong> {bout.data.details}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>

    <!-- Community Events Section -->
    <section>
      <div class="mb-8 pb-3 border-b border-[#252525]">
        <h2 class="font-heading text-3xl sm:text-4xl uppercase tracking-wider text-white">
          Community Appearances &amp; Fundraisers
        </h2>
        <p class="text-gray-400 text-sm">Parades, gear swaps, and outreach in Brookings</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sortedEvents.map((evt) => {
          const evtDate = new Date(evt.data.date);
          const dateString = evtDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

          return (
            <div class="bg-[#181818] p-6 rounded-xl border border-[#2A2A2A] space-y-3 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider rounded bg-[#252525] text-gray-300">
                    {evt.data.category === 'fundraiser' ? 'Fundraiser' : 'Community Event'}
                  </span>
                  <span class="text-xs text-gray-400 font-mono">{dateString}</span>
                </div>
                
                <h3 class="font-heading text-2xl text-white uppercase tracking-wider">
                  {evt.data.title}
                </h3>
                
                <p class="text-xs text-red-400 mb-3">
                  📍 {evt.data.location} {evt.data.time && `• ⏰ ${evt.data.time}`}
                </p>
                
                <p class="text-sm text-gray-300 leading-relaxed">
                  {evt.data.description}
                </p>
              </div>

              <div class="pt-3 border-t border-[#252525]">
                <a 
                  href="https://www.facebook.com/midwestmaidens" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-xs font-medium text-gray-400 hover:text-white inline-flex items-center gap-1"
                >
                  Event Updates on Facebook &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

  </div>
</Layout>
