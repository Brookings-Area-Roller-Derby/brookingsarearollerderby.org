---
import { getCollection } from 'astro:content';
import BoutCard from '../components/BoutCard.astro';
import EventCard from '../components/EventCard.astro';
import { siteConfig } from '../config/site';
import Layout from '../layouts/Layout.astro';
import { partitionByDate } from '../lib/events';

const bouts = partitionByDate(await getCollection('bouts'));
const events = partitionByDate(await getCollection('events'));
const hasUpcoming = bouts.upcoming.length > 0 || events.upcoming.length > 0;
const hasPast = bouts.past.length > 0 || events.past.length > 0;
---

<Layout
  title={`${siteConfig.season} Schedule & Bouts`}
  description={`Full ${siteConfig.season} Brookings Area Roller Derby schedule including home bouts, away matches, and community appearances.`}
>
  <section class="bg-[#121212] py-14 border-b border-[#252525]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span
        class="inline-block px-3 py-1 bg-[#541221] text-white font-semibold uppercase text-xs tracking-wider rounded mb-3"
      >
        {siteConfig.season} Season
      </span>
      <h1 class="font-heading text-5xl sm:text-7xl uppercase tracking-wider text-white">
        Bout Schedule &amp; Events
      </h1>
      <p class="text-gray-400 text-base sm:text-lg max-w-2xl mt-2">
        Catch BARD in action on our home track in Brookings, SD or on the road across the upper
        Midwest.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16" data-schedule>
    <section data-schedule-section="upcoming" hidden={!hasUpcoming}>
      <div class="mb-8 pb-3 border-b border-[#252525]">
        <h2 class="font-heading text-3xl sm:text-4xl uppercase tracking-wider text-white">
          Upcoming
        </h2>
        <p class="text-gray-400 text-sm">Future bouts, tournaments, and community appearances</p>
      </div>

      <div class="space-y-12">
        <div data-event-group="upcoming-bouts" hidden={bouts.upcoming.length === 0}>
          <h3 class="font-heading text-2xl uppercase tracking-wider text-white mb-5">
            Competitive Bouts
          </h3>
          <div id="upcoming-bouts" class="space-y-5" data-event-container>
            {bouts.upcoming.map((bout) => <BoutCard bout={bout} status="upcoming" />)}
          </div>
        </div>

        <div data-event-group="upcoming-events" hidden={events.upcoming.length === 0}>
          <h3 class="font-heading text-2xl uppercase tracking-wider text-white mb-5">
            Community Events
          </h3>
          <div
            id="upcoming-events"
            class="grid grid-cols-1 md:grid-cols-2 gap-6"
            data-event-container
          >
            {events.upcoming.map((event) => <EventCard event={event} status="upcoming" />)}
          </div>
        </div>
      </div>
    </section>

    <div
      class="bg-[#181818] border border-[#2A2A2A] rounded-xl p-8 text-center"
      data-no-upcoming
      hidden={hasUpcoming}
    >
      <h2 class="font-heading text-3xl uppercase tracking-wider text-white">
        New dates coming soon
      </h2>
      <p class="text-gray-400 mt-2">
        Follow BARD on Facebook for schedule announcements and updates.
      </p>
      <a
        href={siteConfig.facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-5 px-5 py-2 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase tracking-wider rounded"
      >
        Follow on Facebook
      </a>
    </div>

    <section data-schedule-section="past" hidden={!hasPast}>
      <div class="mb-8 pb-3 border-b border-[#252525]">
        <h2 class="font-heading text-3xl sm:text-4xl uppercase tracking-wider text-white">
          Past Events
        </h2>
        <p class="text-gray-400 text-sm">
          Completed bouts and community appearances from this season
        </p>
      </div>

      <div class="space-y-12">
        <div data-event-group="past-bouts" hidden={bouts.past.length === 0}>
          <h3 class="font-heading text-2xl uppercase tracking-wider text-white mb-5">
            Competitive Bouts
          </h3>
          <div id="past-bouts" class="space-y-5" data-event-container>
            {bouts.past.map((bout) => <BoutCard bout={bout} status="past" />)}
          </div>
        </div>

        <div data-event-group="past-events" hidden={events.past.length === 0}>
          <h3 class="font-heading text-2xl uppercase tracking-wider text-white mb-5">
            Community Events
          </h3>
          <div id="past-events" class="grid grid-cols-1 md:grid-cols-2 gap-6" data-event-container>
            {events.past.map((event) => <EventCard event={event} status="past" />)}
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const schedule = document.querySelector('[data-schedule]');

  if (schedule instanceof HTMLElement) {
    const cards = Array.from(schedule.querySelectorAll<HTMLElement>('[data-event-card]'));
    const now = Date.now();

    for (const card of cards) {
      const eventDate = new Date(card.dataset.eventDate ?? '').getTime();
      const status = eventDate > now ? 'upcoming' : 'past';
      const type = card.dataset.eventType;
      const destination = document.getElementById(`${status}-${type}`);
      const badge = card.querySelector('[data-event-status]');

      if (destination) destination.append(card);
      if (badge) badge.textContent = status === 'past' ? 'Completed' : 'Upcoming';
    }

    for (const container of schedule.querySelectorAll<HTMLElement>('[data-event-container]')) {
      const isPast = container.id.startsWith('past-');
      const sortedCards = Array.from(
        container.querySelectorAll<HTMLElement>('[data-event-card]'),
      ).sort((a, b) => {
        const difference =
          new Date(a.dataset.eventDate ?? '').getTime() -
          new Date(b.dataset.eventDate ?? '').getTime();
        return isPast ? -difference : difference;
      });

      for (const card of sortedCards) container.append(card);
    }

    for (const group of schedule.querySelectorAll<HTMLElement>('[data-event-group]')) {
      group.hidden = group.querySelectorAll('[data-event-card]').length === 0;
    }

    const upcomingCount = schedule.querySelectorAll(
      '#upcoming-bouts [data-event-card], #upcoming-events [data-event-card]',
    ).length;
    const pastCount = schedule.querySelectorAll(
      '#past-bouts [data-event-card], #past-events [data-event-card]',
    ).length;
    const upcomingSection = schedule.querySelector<HTMLElement>(
      '[data-schedule-section="upcoming"]',
    );
    const pastSection = schedule.querySelector<HTMLElement>('[data-schedule-section="past"]');
    const noUpcoming = schedule.querySelector<HTMLElement>('[data-no-upcoming]');

    if (upcomingSection) upcomingSection.hidden = upcomingCount === 0;
    if (pastSection) pastSection.hidden = pastCount === 0;
    if (noUpcoming) noUpcoming.hidden = upcomingCount > 0;
  }
</script>
