---
import Layout from '../layouts/Layout.astro';
import BoutCountdown from '../components/BoutCountdown.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.jpg';
import { siteConfig } from '../config/site';

const bouts = await getCollection('bouts', ({ data }) => !data.canceled);
const countdownEvents = bouts.map((bout) => ({
  title: bout.data.title,
  date: bout.data.date.toISOString(),
  location: bout.data.location,
}));
---

<Layout title="Home - South Dakota Flat Track Roller Derby">
  <!-- Hero Section -->
  <section class="relative bg-[#121212] py-16 lg:py-24 border-b border-[#252525]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Hero Content -->
        <div class="lg:col-span-8 space-y-6 text-center lg:text-left">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 bg-[#1E1E1E] border border-[#333] rounded-full text-xs font-semibold uppercase text-gray-300 tracking-wider"
          >
            <span class="w-2 h-2 rounded-full bg-red-600"></span>
            Eastern South Dakota • Skater-Owned 501(c)(3)
          </div>

          <h1
            class="font-heading text-6xl sm:text-7xl lg:text-8xl uppercase tracking-tight text-white leading-none"
          >
            Hard Hits.<br />
            <span class="text-red-500">Fast Wheels.</span><br />
            Pure Community.
          </h1>

          <p class="text-lg text-gray-300 max-w-2xl font-normal leading-relaxed">
            Brookings Area Roller Derby (BARD) brings competitive full-contact flat-track roller
            derby to Brookings, SD. Adult skaters, referees, volunteers, and youth seeking a
            junior-program referral are welcome.
          </p>

          <!-- CTAs -->
          <div class="pt-2 flex flex-wrap justify-center lg:justify-start gap-4">
            <a
              href="/schedule"
              class="px-8 py-3.5 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading text-xl uppercase tracking-wider rounded-md border border-[#9E1F3D] transition-colors shadow-lg"
            >
              {siteConfig.season} Bout Schedule
            </a>
            <a
              href="/derby-101"
              class="px-6 py-3.5 bg-[#1F1F1F] hover:bg-[#2A2A2A] text-[#E5A93C] hover:text-white font-heading text-xl uppercase tracking-wider rounded-md border border-[#541221] transition-colors inline-flex items-center gap-1.5"
            >
              <span>⭐</span> Derby 101 Guide
            </a>
            <a
              href="/join"
              class="px-8 py-3.5 bg-[#1F1F1F] hover:bg-[#2A2A2A] text-white font-heading text-xl uppercase tracking-wider rounded-md border border-[#3A3A3A] transition-colors"
            >
              Join the League
            </a>
            <a
              href="/sponsors"
              class="px-6 py-3.5 bg-transparent hover:bg-white/5 text-gray-300 font-heading text-xl uppercase tracking-wider rounded-md border border-[#2E2E2E] transition-colors"
            >
              Become a Sponsor
            </a>
          </div>
        </div>

        <!-- Right Hero Logo Visual -->
        <div class="lg:col-span-4 flex justify-center">
          <div
            class="bg-[#181818] border border-[#2A2A2A] p-8 rounded-2xl shadow-2xl text-center max-w-sm w-full"
          >
            <div
              class="w-48 h-48 sm:w-56 sm:h-56 mx-auto flex items-center justify-center mb-6 rounded-full bg-white p-3 shadow-inner"
            >
              <Image
                src={logoImage}
                alt="Brookings Area Roller Derby Official Logo"
                class="w-full h-full object-contain drop-shadow-xl"
              />
            </div>
            <h2 class="font-heading text-3xl text-white uppercase tracking-wider">
              Brookings Area
            </h2>
            <p class="text-xs uppercase tracking-widest text-red-500 font-semibold mt-0.5">
              Roller Derby League
            </p>
            <p class="text-xs text-gray-400 font-mono mt-3 pt-3 border-t border-[#2A2A2A]">
              Home Arena: Outdoor Adventure Center
            </p>
          </div>
        </div>
      </div>

      <!-- Live Bout Countdown -->
      {
        countdownEvents.length > 0 && (
          <div class="mt-14">
            <BoutCountdown events={countdownEvents} />
          </div>
        )
      }

      <!-- Derby 101 Spectator Teaser Banner -->
      <div
        class="mt-10 bg-gradient-to-r from-[#200B11] via-[#181818] to-[#200B11] border border-[#541221] rounded-xl p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl"
      >
        <div class="flex items-center gap-4 text-center sm:text-left">
          <div
            class="w-12 h-12 rounded-xl bg-[#541221] border border-[#9E1F3D] flex items-center justify-center text-2xl flex-shrink-0 text-[#E5A93C]"
          >
            ⭐
          </div>
          <div>
            <h3 class="font-heading text-xl sm:text-2xl text-white uppercase tracking-wider">
              New to Roller Derby?
            </h3>
            <p class="text-gray-300 text-xs sm:text-sm">
              Understand the pack, jammers, scoring, and call-offs in 60 seconds with our interactive track simulator.
            </p>
          </div>
        </div>
        <a
          href="/derby-101"
          class="flex-shrink-0 px-5 py-2.5 bg-[#E5A93C] hover:bg-[#D49228] text-black font-heading text-base uppercase tracking-wider rounded-md font-bold transition-colors shadow inline-flex items-center gap-1.5"
        >
          <span>Derby 101 Guide</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Feature Cards Grid -->
  <section class="py-16 bg-[#161616] border-b border-[#252525]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-heading text-4xl sm:text-5xl uppercase tracking-wider text-white mb-2">
          Get Involved with BARD
        </h2>
        <p class="text-gray-400 text-sm sm:text-base">
          Athleticism, teamwork, and empowering sportsmanship for athletes and fans of all
          backgrounds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div
          class="bg-[#1C1C1C] border border-[#2A2A2A] hover:border-red-800 p-8 rounded-xl transition-colors flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 bg-[#541221] rounded-lg flex items-center justify-center text-white mb-6"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="font-heading text-2xl text-white uppercase tracking-wider mb-2">
              Adult Derby &amp; Junior Bouts
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
              We operate competitive full-contact adult squads, and BARD proudly hosts and supports SoDAK Attack junior bouts at home games.
            </p>
          </div>
          <a
            href="/roster"
            class="text-red-400 hover:text-red-300 font-heading uppercase text-base tracking-wider inline-flex items-center gap-1"
          >
            Meet the Skater Roster &rarr;
          </a>
        </div>

        <!-- Feature 2 -->
        <div
          class="bg-[#1C1C1C] border border-[#2A2A2A] hover:border-red-800 p-8 rounded-xl transition-colors flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 bg-[#541221] rounded-lg flex items-center justify-center text-white mb-6"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="font-heading text-2xl text-white uppercase tracking-wider mb-2">
              {siteConfig.season} Home Bouts
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
              Catch the live action at the Brookings County Outdoor Adventure Center! Doubleheaders,
              concessions, and family fun.
            </p>
          </div>
          <a
            href="/schedule"
            class="text-red-400 hover:text-red-300 font-heading uppercase text-base tracking-wider inline-flex items-center gap-1"
          >
            View Match Schedule &rarr;
          </a>
        </div>

        <!-- Feature 3 -->
        <div
          class="bg-[#1C1C1C] border border-[#2A2A2A] hover:border-red-800 p-8 rounded-xl transition-colors flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 bg-[#541221] rounded-lg flex items-center justify-center text-white mb-6"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
              </svg>
            </div>
            <h3 class="font-heading text-2xl text-white uppercase tracking-wider mb-2">
              Zero Experience Needed
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
              No prior skating background necessary. Reach out to our league and we'll provide full
              guidance, training steps, and loaner gear for new skaters, refs, and NSOs.
            </p>
          </div>
          <a
            href="/join"
            class="text-red-400 hover:text-red-300 font-heading uppercase text-base tracking-wider inline-flex items-center gap-1"
          >
            Join the League &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Non-Profit 501(c)(3) Mission Statement -->
  <section class="py-14 bg-[#541221] text-white">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-3">
      <span
        class="inline-block px-3 py-0.5 bg-black/40 text-gray-200 font-semibold uppercase tracking-wider text-xs rounded-full"
      >
        501(c)(3) Non-Profit Mission
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl uppercase tracking-wider">
        Community Empowerment Through Athletics
      </h2>
      <p class="text-gray-200 text-sm sm:text-base leading-relaxed">
        Brookings Area Roller Derby is dedicated to promoting physical fitness, self-confidence, and
        sportsmanship through full-contact flat-track roller derby. We actively serve the Brookings
        community through charity drives, youth mentorship, and volunteer outreach.
      </p>
    </div>
  </section>
</Layout>
