---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import defaultLogo from '../assets/logo.jpg';
import { normalizeImageUrl } from '../lib/images';

const roster = await getCollection('roster', ({ data }) => data.active);
const jammers = roster.filter((m) => m.data.positions.includes('Jammer'));
const blockers = roster.filter((m) => m.data.positions.includes('Blocker'));
const pivots = roster.filter((m) => m.data.positions.includes('Pivot'));
const officials = roster.filter((m) =>
  m.data.positions.some((p) => p === 'Ref' || p === 'NSO'),
);
---

<Layout
  title="Skater Roster"
  description="Meet the active blockers, jammers, pivots, referees, and officials of Brookings Area Roller Derby (BARD)."
>
  <!-- Hero Section -->
  <section class="bg-[#121212] py-12 sm:py-16 border-b border-[#252525]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span
            class="inline-block px-3 py-1 bg-[#541221] text-white font-semibold uppercase text-xs tracking-wider rounded mb-3"
          >
            {roster.length} Active League Members
          </span>
          <h1 class="font-heading text-5xl sm:text-7xl uppercase tracking-wider text-white">
            Meet the Pack
          </h1>
          <p class="text-gray-400 text-base sm:text-lg max-w-2xl mt-2">
            The competitive skaters, pivots, blockers, jammers, and zebra referees of BARD.
          </p>
        </div>

        <!-- Quick Summary Stats -->
        <div class="flex items-center gap-3 text-center">
          <div class="bg-[#181818] border border-[#2A2A2A] rounded-lg px-3.5 py-2">
            <span class="font-heading text-2xl text-red-500 block leading-none">{jammers.length}</span>
            <span class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Jammers</span>
          </div>
          <div class="bg-[#181818] border border-[#2A2A2A] rounded-lg px-3.5 py-2">
            <span class="font-heading text-2xl text-gray-200 block leading-none">{blockers.length}</span>
            <span class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Blockers</span>
          </div>
          <div class="bg-[#181818] border border-[#2A2A2A] rounded-lg px-3.5 py-2">
            <span class="font-heading text-2xl text-[#E5A93C] block leading-none">{pivots.length}</span>
            <span class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Pivots</span>
          </div>
          <div class="bg-[#181818] border border-[#2A2A2A] rounded-lg px-3.5 py-2">
            <span class="font-heading text-2xl text-white block leading-none">{officials.length}</span>
            <span class="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Officials</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky SPA Toolbar & Main Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 relative" id="roster-container">
    <!-- Sticky App-Style Control Bar -->
    <div
      class="sticky top-0 z-30 bg-[#121212]/95 backdrop-blur-md border-b border-[#282828] py-4 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mb-8 transition-all shadow-md"
    >
      <div class="max-w-7xl mx-auto space-y-3">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <!-- Search Input -->
          <div class="relative flex-1 max-w-md">
            <input
              type="text"
              id="roster-search"
              placeholder="Search by skater name or #number..."
              class="w-full px-4 py-2 pl-9 bg-[#1A1A1A] border border-[#333] rounded-lg text-sm text-white placeholder-gray-500 focus:outline-none focus:border-[#E5A93C] transition-colors"
            />
            <span class="absolute left-3 top-2.5 text-gray-500 text-xs pointer-events-none">🔍</span>
          </div>

          <!-- Sort Selector & Visible Counter -->
          <div class="flex items-center justify-between sm:justify-end gap-4">
            <div class="flex items-center gap-2">
              <label for="roster-sort" class="text-xs text-gray-400 font-medium whitespace-nowrap">Sort:</label>
              <select
                id="roster-sort"
                class="bg-[#1A1A1A] border border-[#333] text-gray-300 text-xs rounded-md px-2.5 py-1.5 focus:outline-none focus:border-[#E5A93C]"
              >
                <option value="number">Jersey # (0-9)</option>
                <option value="name">Name (A-Z)</option>
              </select>
            </div>
            <div class="text-xs font-mono text-gray-400 whitespace-nowrap">
              Showing <span id="visible-count" class="text-[#E5A93C] font-bold">{roster.length}</span> of {roster.length}
            </div>
          </div>
        </div>

        <!-- Position Filter Pills -->
        <div class="flex flex-wrap items-center gap-2 overflow-x-auto pb-1 pt-1">
          <button
            type="button"
            data-filter="all"
            class="roster-filter-btn px-3 py-1 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#541221] text-white border-[#7A1A30]"
          >
            All ({roster.length})
          </button>
          <button
            type="button"
            data-filter="Jammer"
            class="roster-filter-btn px-3 py-1 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
          >
            Jammers ({jammers.length})
          </button>
          <button
            type="button"
            data-filter="Blocker"
            class="roster-filter-btn px-3 py-1 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
          >
            Blockers ({blockers.length})
          </button>
          <button
            type="button"
            data-filter="Pivot"
            class="roster-filter-btn px-3 py-1 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
          >
            Pivots ({pivots.length})
          </button>
          <button
            type="button"
            data-filter="Official"
            class="roster-filter-btn px-3 py-1 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
          >
            Officials &amp; Refs ({officials.length})
          </button>
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <div
      id="roster-empty"
      class="hidden bg-[#181818] border border-[#2A2A2A] rounded-2xl p-12 text-center space-y-3 my-8"
    >
      <div class="text-4xl">🛼</div>
      <h3 class="font-heading text-2xl uppercase tracking-wider text-white">No Skaters Found</h3>
      <p class="text-gray-400 text-sm max-w-md mx-auto">
        No roster members match your search or filter criteria.
      </p>
      <button
        type="button"
        id="reset-filters"
        class="inline-block mt-2 px-4 py-2 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase text-xs tracking-wider rounded"
      >
        Reset Filters
      </button>
    </div>

    <!-- Roster Grid -->
    <div
      id="roster-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
    >
      {
        roster.map((member) => (
          <div
            class="roster-card bg-[#181818] rounded-xl border border-[#2A2A2A] hover:border-[#541221] overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-200 flex flex-col justify-between group"
            data-name={member.data.derbyName.toLowerCase()}
            data-number={member.data.number.toLowerCase()}
            data-positions={member.data.positions.join(',')}
            data-is-official={
              member.data.positions.some((p) => p === 'Ref' || p === 'NSO') ? 'true' : 'false'
            }
          >
            <div>
              <div class="bg-[#121212] p-5 text-center border-b border-[#252525] relative">
                <div class="w-28 h-28 mx-auto bg-white rounded-full border-2 border-[#333] shadow-inner mb-2.5 overflow-hidden flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
                  {
                    typeof member.data.photo === 'string' ? (
                      <img
                        src={normalizeImageUrl(member.data.photo)}
                        alt={`${member.data.derbyName} - #${member.data.number}`}
                        class="w-full h-full object-cover object-top"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : member.data.photo ? (
                      <Image
                        src={member.data.photo}
                        alt={`${member.data.derbyName} - #${member.data.number}`}
                        class="w-full h-full object-cover object-top"
                      />
                    ) : (
                      <Image
                        src={defaultLogo}
                        alt={`${member.data.derbyName} - #${member.data.number}`}
                        class="w-full h-full object-contain p-2"
                      />
                    )
                  }
                </div>

                <span class="inline-block px-3 py-0.5 bg-[#541221] text-white font-mono font-bold text-xs tracking-wider rounded-full shadow">
                  #{member.data.number}
                </span>
              </div>

              <div class="p-5 space-y-2.5">
                <div>
                  <h3 class="font-heading text-2xl text-white uppercase tracking-wider leading-tight group-hover:text-red-400 transition-colors">
                    {member.data.derbyName}
                  </h3>
                </div>

                <div class="flex flex-wrap gap-1.5 pt-0.5">
                  {member.data.positions.map((pos) => {
                    let badgeColor = 'bg-[#252525] text-gray-300 border-[#333]';
                    if (pos === 'Jammer') badgeColor = 'bg-[#541221] text-white border-[#7A1A30]';
                    if (pos === 'Pivot') badgeColor = 'bg-[#1E1E1E] text-red-400 border-[#3B0B16]';
                    if (pos === 'Ref' || pos === 'NSO')
                      badgeColor = 'bg-[#2A2A2A] text-[#E5A93C] border-[#E5A93C]/40';

                    return (
                      <span
                        class={`px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider rounded border ${badgeColor}`}
                      >
                        {pos}
                      </span>
                    );
                  })}
                </div>

                {member.body && (
                  <p class="text-xs text-gray-300 leading-relaxed pt-1.5 font-sans line-clamp-4">
                    {member.body}
                  </p>
                )}
              </div>
            </div>

            <div class="p-2.5 bg-[#141414] border-t border-[#222] text-center">
              <span class="text-[11px] font-sans uppercase text-gray-500 tracking-wider">
                {member.data.positions.some((p) => p === 'Ref' || p === 'NSO')
                  ? 'BARD Official • Active'
                  : 'BARD Skater • Active'}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Floating Back to Top Button -->
    <button
      type="button"
      id="back-to-top"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-40 bg-[#541221] hover:bg-[#7A1A30] text-white p-3 rounded-full shadow-2xl border border-[#9E1F3D] opacity-0 pointer-events-none transition-all duration-300 translate-y-2 hover:scale-110"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>

    <!-- Recruitment CTA -->
    <div
      class="mt-16 bg-[#181818] p-8 sm:p-12 rounded-2xl border border-[#2E2E2E] text-center space-y-4 shadow-xl"
    >
      <h2 class="font-heading text-4xl sm:text-5xl uppercase tracking-wider text-white">
        Want to skate with BARD?
      </h2>
      <p class="text-gray-300 text-base max-w-xl mx-auto">
        We teach complete beginners how to skate, hit, and play derby safely. Referees and
        non-skating officials are also in high demand!
      </p>
      <div class="pt-2">
        <a
          href="/join"
          class="inline-block px-8 py-3 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase tracking-wider text-lg rounded-md transition-colors"
        >
          Join Fresh Meat Clinic &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupRosterSPA() {
    const searchInput = document.getElementById('roster-search') as HTMLInputElement | null;
    const sortSelect = document.getElementById('roster-sort') as HTMLSelectElement | null;
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.roster-filter-btn'));
    const grid = document.getElementById('roster-grid');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.roster-card'));
    const visibleCount = document.getElementById('visible-count');
    const emptyState = document.getElementById('roster-empty');
    const resetBtn = document.getElementById('reset-filters');
    const backToTopBtn = document.getElementById('back-to-top');

    let activeFilter = 'all';
    let searchQuery = '';

    function sortAndFilterCards() {
      let visible = 0;
      const sortBy = sortSelect?.value ?? 'number';

      // Sort
      const sorted = [...cards].sort((a, b) => {
        if (sortBy === 'name') {
          return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
        }
        // numeric / string comparison for numbers
        const numA = a.dataset.number ?? '';
        const numB = b.dataset.number ?? '';
        return numA.localeCompare(numB, undefined, { numeric: true, sensitivity: 'base' });
      });

      if (grid) {
        for (const card of sorted) {
          grid.appendChild(card);
        }
      }

      // Filter
      for (const card of cards) {
        const name = card.dataset.name ?? '';
        const number = card.dataset.number ?? '';
        const positions = (card.dataset.positions ?? '').split(',');
        const isOfficial = card.dataset.isOfficial === 'true';

        const matchesSearch =
          !searchQuery ||
          name.includes(searchQuery) ||
          number.includes(searchQuery);

        let matchesFilter = true;
        if (activeFilter === 'all') {
          matchesFilter = true;
        } else if (activeFilter === 'Official') {
          matchesFilter = isOfficial;
        } else {
          matchesFilter = positions.includes(activeFilter);
        }

        if (matchesSearch && matchesFilter) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      }

      if (visibleCount) visibleCount.textContent = String(visible);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        sortAndFilterCards();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        sortAndFilterCards();
      });
    }

    for (const btn of filterButtons) {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.filter ?? 'all';

        for (const b of filterButtons) {
          b.className =
            'roster-filter-btn px-3 py-1 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500';
        }
        btn.className =
          'roster-filter-btn px-3 py-1 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#541221] text-white border-[#7A1A30]';

        sortAndFilterCards();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeFilter = 'all';
        for (const b of filterButtons) {
          if (b.dataset.filter === 'all') {
            b.click();
          }
        }
      });
    }

    // Scroll listener for floating Back-to-Top button
    if (backToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
          backToTopBtn.classList.add('opacity-100', 'translate-y-0');
        } else {
          backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
          backToTopBtn.classList.remove('opacity-100', 'translate-y-0');
        }
      });

      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Initial sort
    sortAndFilterCards();
  }

  setupRosterSPA();
</script>
