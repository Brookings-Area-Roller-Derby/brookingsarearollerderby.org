---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import DerbyCard from '../components/DerbyCard.astro';

// Sort helper: jersey number first (natural order), then alphabetical
const sortRosterMembers = (list: typeof allMembers) =>
  [...list].sort((a, b) => {
    const numA = a.data.number ? String(a.data.number).trim() : '';
    const numB = b.data.number ? String(b.data.number).trim() : '';
    if (numA && numB) {
      const cmp = numA.localeCompare(numB, undefined, { numeric: true, sensitivity: 'base' });
      if (cmp !== 0) return cmp;
      return a.data.derbyName.localeCompare(b.data.derbyName);
    }
    if (numA && !numB) return -1;
    if (!numA && numB) return 1;
    return a.data.derbyName.localeCompare(b.data.derbyName);
  });

const allMembers = await getCollection('roster', ({ data }) => data.active);

// Separate members by their explicit section property in frontmatter
// 'roster': Active roster (skaters, skater-coaches)
// 'coaches': Bench coaches / coaching staff
// 'officials': Referees, NSOs, and volunteers
const activeRoster = sortRosterMembers(allMembers.filter((m) => m.data.section === 'roster'));
const coachesList = sortRosterMembers(allMembers.filter((m) => m.data.section === 'coaches'));
const officialsAndVolunteers = sortRosterMembers(
  allMembers.filter((m) => m.data.section === 'officials'),
);
---

<Layout
  title="Skater Roster | Brookings Area Roller Derby (BARD)"
  description="Meet the active skaters, jammers, blockers, pivots, coaches, and officials of Brookings Area Roller Derby (BARD)."
>
  <!-- Hero Section -->
  <section class="bg-[#121212] py-12 sm:py-16 border-b border-[#252525] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span
            class="inline-block px-3 py-1 bg-[#541221] text-[#E5A93C] font-mono text-xs uppercase tracking-widest rounded border border-[#7A1A30]"
          >
            ✦ 2026 OFFICIAL ROSTER ✦
          </span>
          <span
            class="px-2.5 py-1 bg-[#1C1C1C] text-gray-300 font-mono text-xs rounded border border-[#333]"
          >
            SKATERS: {activeRoster.length} ATHLETES
          </span>
          {
            coachesList.length > 0 && (
              <span class="px-2.5 py-1 bg-[#1C1C1C] text-gray-300 font-mono text-xs rounded border border-[#333]">
                COACHES: {coachesList.length}
              </span>
            )
          }
          {
            officialsAndVolunteers.length > 0 && (
              <span class="px-2.5 py-1 bg-[#1C1C1C] text-gray-300 font-mono text-xs rounded border border-[#333]">
                CREW: {officialsAndVolunteers.length} OFFICIALS
              </span>
            )
          }
        </div>
        <h1 class="font-heading text-5xl sm:text-7xl uppercase tracking-wider text-white">
          Meet the Pack
        </h1>
        <p class="text-gray-400 text-base sm:text-lg max-w-2xl mt-2 leading-relaxed">
          The competitive skaters, pivots, blockers, jammers, bench coaches, and dedicated crew of
          BARD.
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky SPA Toolbar & Main Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 relative" id="roster-container">
    <!-- Sticky App-Style Control Bar -->
    <div
      class="sticky top-16 sm:top-20 z-30 bg-[#121212]/95 backdrop-blur-md border-b border-[#282828] py-4 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mb-8 transition-all shadow-md"
    >
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <!-- Search Input -->
          <div class="relative flex-1 max-w-md">
            <input
              type="text"
              id="roster-search"
              placeholder="Search by skater name or #number..."
              class="w-full px-4 py-2 pl-9 pr-9 bg-[#1A1A1A] border border-[#333] rounded-lg text-sm text-white placeholder-gray-400 focus:outline-none focus:border-[#E5A93C] transition-colors"
            />
            <span class="absolute left-3 top-2.5 text-gray-400 text-xs pointer-events-none">🔍</span
            >
            <button
              type="button"
              id="roster-search-clear"
              class="hidden absolute right-2.5 top-2 text-gray-400 hover:text-white p-1 rounded-full text-xs transition-colors"
              aria-label="Clear search query"
            >
              ✕
            </button>
          </div>

          <!-- Sort Selector -->
          <div class="flex items-center justify-end gap-2">
            <label for="roster-sort" class="text-xs text-gray-400 font-medium whitespace-nowrap"
              >Sort:</label
            >
            <select
              id="roster-sort"
              class="bg-[#1A1A1A] border border-[#333] text-gray-300 text-xs rounded-md px-2.5 py-1.5 focus:outline-none focus:border-[#E5A93C]"
            >
              <option value="number">Jersey # (0-9)</option>
              <option value="name">Name (A-Z)</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Count Counter Indicator -->
    <div class="flex items-center justify-between text-xs text-gray-400 mb-4 px-1">
      <span>
        Showing <strong id="visible-count" class="text-[#E5A93C] font-mono"
          >{allMembers.length}</strong
        > of
        <strong class="text-white font-mono">{allMembers.length}</strong> members
      </span>
      <span class="text-gray-400 text-[11px] hidden sm:inline">
        Click any card to inspect full bio
      </span>
    </div>

    <!-- Empty State -->
    <div
      id="roster-empty"
      class="hidden bg-[#181818] border border-[#2A2A2A] rounded-2xl p-12 text-center space-y-3 my-8"
    >
      <div class="text-4xl">🛼</div>
      <h3 class="font-heading text-2xl uppercase tracking-wider text-white">No Members Found</h3>
      <p class="text-gray-400 text-sm max-w-md mx-auto">
        No roster or crew members match your search criteria.
      </p>
      <button
        type="button"
        id="reset-filters"
        class="inline-block mt-2 px-4 py-2 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase text-xs tracking-wider rounded transition-colors"
      >
        Clear Search
      </button>
    </div>

    <!-- Active Roster Section -->
    <section id="section-active-roster" class="mb-14">
      <div class="flex items-center gap-3 mb-6 pb-2 border-b border-[#282828]">
        <h2 class="font-heading text-2xl sm:text-3xl text-white uppercase tracking-wider">
          Active Roster
        </h2>
        <span
          class="px-2.5 py-0.5 bg-[#1F1F1F] text-[#E5A93C] font-mono text-xs font-semibold rounded border border-[#E5A93C]/30"
        >
          Skaters &amp; Player-Coaches
        </span>
      </div>

      <div
        id="roster-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 auto-rows-fr"
      >
        {activeRoster.map((member, index) => <DerbyCard member={member} index={index} />)}
      </div>
    </section>

    <!-- Bench Coaches Section -->
    {
      coachesList.length > 0 && (
        <section id="section-coaches" class="mb-14">
          <div class="flex items-center gap-3 mb-6 pb-2 border-b border-[#282828]">
            <h2 class="font-heading text-2xl sm:text-3xl text-white uppercase tracking-wider">
              Coaching Staff
            </h2>
            <span class="px-2.5 py-0.5 bg-[#1F1F1F] text-[#E5A93C] font-mono text-xs font-semibold rounded border border-[#E5A93C]/30">
              Bench Coaches
            </span>
          </div>
          <p class="text-gray-400 text-sm mb-6 -mt-3">
            The masterminds behind our strategy, pack dynamics, and bench leadership.
          </p>

          <div
            id="coaches-grid"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 auto-rows-fr"
          >
            {coachesList.map((member, index) => (
              <DerbyCard member={member} index={activeRoster.length + index} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Officials & Volunteers Section -->
    {
      officialsAndVolunteers.length > 0 && (
        <section id="section-officials-volunteers" class="mb-12">
          <div class="flex items-center gap-3 mb-6 pb-2 border-b border-[#282828]">
            <h2 class="font-heading text-2xl sm:text-3xl text-white uppercase tracking-wider">
              Officials &amp; Volunteers
            </h2>
            <span class="px-2.5 py-0.5 bg-[#1F1F1F] text-gray-300 font-mono text-xs font-semibold rounded border border-[#333]">
              Referees &amp; Non-Skating Officials
            </span>
          </div>
          <p class="text-gray-400 text-sm mb-6 -mt-3">
            Our bouts and operations run thanks to dedicated referees, non-skating officials (NSOs),
            and volunteers who keep the wheels turning.
          </p>

          <div
            id="officials-grid"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 auto-rows-fr"
          >
            {officialsAndVolunteers.map((member, index) => (
              <DerbyCard member={member} index={activeRoster.length + coachesList.length + index} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Floating Back to Top Button -->
    <button
      type="button"
      id="back-to-top"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-40 bg-[#541221] hover:bg-[#7A1A30] text-white p-3 rounded-full shadow-2xl border border-[#9E1F3D] opacity-0 pointer-events-none transition-all duration-300 translate-y-2 hover:scale-110"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>

    <!-- Recruitment CTA -->
    <div
      class="mt-16 bg-[#181818] p-8 sm:p-12 rounded-2xl border border-[#2E2E2E] text-center space-y-4 shadow-xl"
    >
      <h2 class="font-heading text-4xl sm:text-5xl uppercase tracking-wider text-white">
        Want to skate with BARD?
      </h2>
      <p class="text-gray-300 text-base max-w-xl mx-auto">
        We teach complete beginners how to skate, hit, and play derby safely. Referees and
        non-skating officials are also in high demand!
      </p>
      <div class="pt-2">
        <a
          href="/join"
          class="px-6 py-3 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase tracking-wider text-base rounded-lg border border-[#9E1F3D] transition-colors whitespace-nowrap"
        >
          Join the Pack &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- Large Card Inspection Modal -->
  <div
    id="derby-card-modal"
    class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-card-name"
  >
    <div
      id="modal-card-dialog"
      class="relative w-full max-w-lg bg-gradient-to-b from-[#1C1C1C] via-[#161616] to-[#121212] rounded-3xl border-2 border-[#E5A93C] p-6 sm:p-8 shadow-[0_25px_60px_rgba(0,0,0,0.9),0_0_30px_rgba(229,169,60,0.25)] text-white space-y-5"
    >
      <!-- Close Button -->
      <button
        type="button"
        id="modal-close-btn"
        aria-label="Close card modal"
        class="absolute top-4 right-4 text-gray-400 hover:text-white bg-[#252525] hover:bg-[#541221] w-10 h-10 rounded-full flex items-center justify-center text-xl transition-all shadow-md z-30"
      >
        ✕
      </button>

      <!-- Modal Card Top Bar -->
      <div class="flex items-center justify-between gap-3 pr-12 pb-3 border-b border-[#2A2A2A]">
        <div>
          <h2
            id="modal-card-name"
            class="font-heading text-3xl sm:text-4xl text-white uppercase tracking-wide leading-none"
          >
          </h2>
        </div>
        <div id="modal-card-number-wrapper" class="flex-shrink-0">
          <span
            id="modal-card-number"
            class="font-heading text-3xl sm:text-4xl text-[#E5A93C] font-bold"></span>
        </div>
      </div>

      <!-- Modal Card Art Frame (Clean) -->
      <div
        id="modal-card-frame"
        class="relative w-full aspect-[4/3] bg-[#0E0E0E] rounded-xl overflow-hidden border border-[#333] shadow-inner flex items-center justify-center transition-colors"
      >
        <img id="modal-card-photo" src="" alt="" class="w-full h-full object-cover object-top" />
      </div>

      <!-- Modal Card Details -->
      <div class="space-y-3">
        <!-- Team Subheader Strip -->
        <div class="mb-2 pb-1.5 border-b border-[#252525]">
          <span
            class="text-[10px] font-mono text-[#E5A93C] uppercase tracking-widest font-semibold"
          >
            Brookings Area Roller Derby
          </span>
        </div>

        <div class="bg-[#151515] p-4 rounded-xl border border-[#262626] max-h-48 overflow-y-auto">
          <div
            id="modal-card-bio"
            class="text-sm text-gray-200 leading-relaxed font-sans space-y-2 [&_strong]:text-white [&_strong]:font-semibold [&_em]:italic [&_em]:text-gray-200 [&_a]:text-[#E5A93C] [&_a]:underline hover:[&_a]:text-[#F3C26B] [&_blockquote]:border-l-2 [&_blockquote]:border-[#E5A93C] [&_blockquote]:pl-3 [&_blockquote]:py-1.5 [&_blockquote]:my-2 [&_blockquote]:bg-[#1A1A1A] [&_blockquote]:rounded-r-md [&_blockquote]:text-gray-200 [&_p]:my-0 [&_p]:leading-relaxed"
          >
          </div>
        </div>

        <!-- Card Bottom Footer: Positions -->
        <div class="pt-2.5 border-t border-[#222] flex flex-wrap items-center gap-1.5">
          <div id="modal-card-positions" class="flex flex-wrap items-center gap-1.5"></div>
        </div>
      </div>

      <!-- Modal Bottom Navigation Controls -->
      <div class="pt-3 border-t border-[#2A2A2A] flex items-center justify-between gap-3">
        <button
          type="button"
          id="modal-prev-btn"
          class="px-4 py-2 bg-[#222] hover:bg-[#541221] text-gray-200 hover:text-white font-heading text-sm uppercase tracking-wider rounded-md border border-[#3A3A3A] transition-colors inline-flex items-center gap-1.5 cursor-pointer"
        >
          ❮ Previous
        </button>
        <span id="modal-card-counter" class="text-xs font-mono text-gray-400"></span>
        <button
          type="button"
          id="modal-next-btn"
          class="px-4 py-2 bg-[#222] hover:bg-[#541221] text-gray-200 hover:text-white font-heading text-sm uppercase tracking-wider rounded-md border border-[#3A3A3A] transition-colors inline-flex items-center gap-1.5 cursor-pointer"
        >
          Next ❯
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupRosterSPA() {
    const searchInput = document.getElementById('roster-search') as HTMLInputElement | null;
    const searchClearBtn = document.getElementById('roster-search-clear');
    const sortSelect = document.getElementById('roster-sort') as HTMLSelectElement | null;
    const rosterGrid = document.getElementById('roster-grid');
    const coachesGrid = document.getElementById('coaches-grid');
    const officialsGrid = document.getElementById('officials-grid');
    const activeSection = document.getElementById('section-active-roster');
    const coachesSection = document.getElementById('section-coaches');
    const officialsSection = document.getElementById('section-officials-volunteers');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.roster-card'));
    const visibleCount = document.getElementById('visible-count');
    const emptyState = document.getElementById('roster-empty');
    const resetBtn = document.getElementById('reset-filters');
    const backToTopBtn = document.getElementById('back-to-top');

    // Modal elements
    const modal = document.getElementById('derby-card-modal');
    const closeBtn = document.getElementById('modal-close-btn');
    const prevBtn = document.getElementById('modal-prev-btn');
    const nextBtn = document.getElementById('modal-next-btn');
    const modalName = document.getElementById('modal-card-name');
    const modalNumber = document.getElementById('modal-card-number');
    const modalPhoto = document.getElementById('modal-card-photo') as HTMLImageElement | null;
    const modalPositions = document.getElementById('modal-card-positions');
    const modalBio = document.getElementById('modal-card-bio');
    const modalCounter = document.getElementById('modal-card-counter');

    let searchQuery = '';
    let currentModalIndex = 0;
    let lastActiveCardTrigger: HTMLElement | null = null;

    function getVisibleCards(): HTMLElement[] {
      return cards.filter((card) => card.style.display !== 'none');
    }

    function sortCardElements(container: HTMLElement | null, sortBy: string) {
      if (!container) return;
      const childCards = Array.from(container.querySelectorAll<HTMLElement>('.roster-card'));
      const sorted = childCards.sort((a, b) => {
        if (sortBy === 'name') {
          return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
        }
        const numA = (a.dataset.number ?? '').trim();
        const numB = (b.dataset.number ?? '').trim();
        if (numA && numB) {
          const cmp = numA.localeCompare(numB, undefined, { numeric: true, sensitivity: 'base' });
          if (cmp !== 0) return cmp;
          return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
        }
        if (numA && !numB) return -1;
        if (!numA && numB) return 1;
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      });

      for (const card of sorted) {
        container.appendChild(card);
      }
    }

    function sortAndFilterCards() {
      let visible = 0;
      let activeVisible = 0;
      let coachesVisible = 0;
      let officialsVisible = 0;
      const sortBy = sortSelect?.value ?? 'number';

      // Sort within each grid container preserving section division
      sortCardElements(rosterGrid, sortBy);
      sortCardElements(coachesGrid, sortBy);
      sortCardElements(officialsGrid, sortBy);

      // Filter
      for (const card of cards) {
        const name = card.dataset.name ?? '';
        const number = card.dataset.number ?? '';

        const matchesSearch =
          !searchQuery || name.includes(searchQuery) || number.includes(searchQuery);

        if (matchesSearch) {
          card.style.display = '';
          visible++;
          if (card.closest('#section-active-roster')) {
            activeVisible++;
          } else if (card.closest('#section-coaches')) {
            coachesVisible++;
          } else if (card.closest('#section-officials-volunteers')) {
            officialsVisible++;
          }
        } else {
          card.style.display = 'none';
        }
      }

      // Hide/show section headers based on whether any cards in that section match
      if (activeSection) {
        activeSection.style.display = activeVisible > 0 ? '' : 'none';
      }
      if (coachesSection) {
        coachesSection.style.display = coachesVisible > 0 ? '' : 'none';
      }
      if (officialsSection) {
        officialsSection.style.display = officialsVisible > 0 ? '' : 'none';
      }

      if (visibleCount) visibleCount.textContent = String(visible);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    // Modal display logic
    function openModalForCard(card: HTMLElement) {
      const visibleCards = getVisibleCards();
      const idx = visibleCards.indexOf(card);
      if (idx === -1) return;
      lastActiveCardTrigger = card;
      currentModalIndex = idx;
      renderModalContent();
      if (modal) {
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        closeBtn?.focus();
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
        if (lastActiveCardTrigger) {
          lastActiveCardTrigger.focus();
          lastActiveCardTrigger = null;
        }
      }
    }

    function renderModalContent() {
      const visibleCards = getVisibleCards();
      if (visibleCards.length === 0) return;
      if (currentModalIndex < 0) currentModalIndex = visibleCards.length - 1;
      if (currentModalIndex >= visibleCards.length) currentModalIndex = 0;

      const card = visibleCards[currentModalIndex];
      if (!card) return;

      const name = card.dataset.cardName || '';
      const number = card.dataset.cardNumber || '';
      const positions = (card.dataset.cardPositions || '')
        .split(',')
        .map((p) => p.trim())
        .filter(Boolean);
      const bioHtml = card.dataset.cardBioHtml;
      const bio = card.dataset.cardBio || 'Active skater with Brookings Area Roller Derby.';

      // Find photo element in card
      const img = card.querySelector('img') as HTMLImageElement | null;
      const photoSrc = card.dataset.cardPhoto || (img ? img.src : '');
      const isDefault = card.dataset.isDefaultLogo === 'true' || photoSrc.includes('logo');
      const modalFrame = document.getElementById('modal-card-frame');

      if (modalName) modalName.textContent = name;
      if (modalNumber)
        modalNumber.textContent = number ? `#${number}` : card.dataset.headerBadge || 'STAFF';
      if (modalPhoto) {
        modalPhoto.src = photoSrc;
        modalPhoto.alt = `${name} roster portrait`;
        if (isDefault) {
          modalPhoto.className = 'w-full h-full object-contain';
        } else {
          modalPhoto.className = 'w-full h-full object-cover object-top';
        }
      }
      if (modalFrame) {
        if (isDefault) {
          modalFrame.className =
            'relative w-full aspect-[4/3] bg-white p-6 rounded-xl overflow-hidden border border-[#333] shadow-inner flex items-center justify-center transition-colors';
        } else {
          modalFrame.className =
            'relative w-full aspect-[4/3] bg-[#0E0E0E] rounded-xl overflow-hidden border border-[#333] shadow-inner flex items-center justify-center transition-colors';
        }
      }
      if (modalBio) {
        if (bioHtml) {
          modalBio.innerHTML = bioHtml;
        } else {
          modalBio.innerHTML = `<p class="italic text-gray-400 font-sans">${bio}</p>`;
        }
      }
      if (modalCounter) {
        modalCounter.textContent = `${currentModalIndex + 1} of ${visibleCards.length}`;
      }

      if (modalPositions) {
        modalPositions.innerHTML = '';
        for (const pos of positions) {
          const badge = document.createElement('span');
          badge.className =
            'px-2 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider rounded bg-[#202020] text-[#E5A93C] border border-[#333]';
          badge.textContent = pos;
          modalPositions.appendChild(badge);
        }
      }
    }

    // Attach card click handlers
    for (const card of cards) {
      card.addEventListener('click', () => {
        openModalForCard(card);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModalForCard(card);
        }
      });
    }

    // Modal controls
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentModalIndex--;
        renderModalContent();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentModalIndex++;
        renderModalContent();
      });
    }

    // Click outside modal dialog to close
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === 'ArrowLeft') {
        currentModalIndex--;
        renderModalContent();
      } else if (e.key === 'ArrowRight') {
        currentModalIndex++;
        renderModalContent();
      } else if (e.key === 'Tab') {
        const focusableElements = [closeBtn, prevBtn, nextBtn].filter(Boolean) as HTMLElement[];
        if (focusableElements.length === 0) return;

        const firstEl = focusableElements[0];
        const lastEl = focusableElements[focusableElements.length - 1];

        if (e.shiftKey && document.activeElement === firstEl) {
          e.preventDefault();
          lastEl.focus();
        } else if (!e.shiftKey && document.activeElement === lastEl) {
          e.preventDefault();
          firstEl.focus();
        }
      }
    });

    function updateSearchClearVisibility() {
      if (searchClearBtn) {
        searchClearBtn.classList.toggle('hidden', !searchQuery);
      }
    }

    // Toolbar listeners
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        updateSearchClearVisibility();
        sortAndFilterCards();
      });
    }

    if (searchClearBtn) {
      searchClearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        searchQuery = '';
        updateSearchClearVisibility();
        sortAndFilterCards();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        sortAndFilterCards();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        updateSearchClearVisibility();
        sortAndFilterCards();
      });
    }

    // Scroll listener for floating Back-to-Top button
    if (backToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
          backToTopBtn.classList.add('opacity-100', 'translate-y-0');
        } else {
          backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
          backToTopBtn.classList.remove('opacity-100', 'translate-y-0');
        }
      });

      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Initial sort
    sortAndFilterCards();
  }

  setupRosterSPA();
</script>
