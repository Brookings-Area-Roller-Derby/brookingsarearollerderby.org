---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import DerbyCard from '../components/DerbyCard.astro';

const roster = await getCollection('roster', ({ data }) => data.active);
const coaches = roster.filter((m) => m.data.positions.includes('Coach'));
const freshMeat = roster.filter((m) => m.data.positions.includes('Fresh Meat'));
---

<Layout
  title="Skater Roster — Collectible Trading Cards"
  description="Meet the active blockers, jammers, pivots, referees, and officials of Brookings Area Roller Derby (BARD) presented as collectible athletic trading cards."
>
  <!-- Hero Section -->
  <section class="bg-[#121212] py-12 sm:py-16 border-b border-[#252525] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span
            class="inline-block px-3 py-1 bg-[#541221] text-[#E5A93C] font-mono text-xs uppercase tracking-widest rounded border border-[#7A1A30]"
          >
            ✦ 2026 OFFICIAL SERIES • TRADING CARDS ✦
          </span>
          <span
            class="px-2.5 py-1 bg-[#1C1C1C] text-gray-300 font-mono text-xs rounded border border-[#333]"
          >
            ROSTER SIZE: {roster.length} ATHLETES
          </span>
        </div>
        <h1 class="font-heading text-5xl sm:text-7xl uppercase tracking-wider text-white">
          Meet the Pack
        </h1>
        <p class="text-gray-400 text-base sm:text-lg max-w-2xl mt-2 leading-relaxed">
          The competitive skaters, pivots, blockers, jammers, and zebra referees of BARD.
          <span class="text-[#E5A93C] block sm:inline mt-1 sm:mt-0 font-medium">
            ✦ Hover cards to catch the holographic foil shimmer, and click any card to inspect full stats!
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky SPA Toolbar & Main Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 relative" id="roster-container">
    <!-- Sticky App-Style Control Bar -->
    <div
      class="sticky top-0 z-30 bg-[#121212]/95 backdrop-blur-md border-b border-[#282828] py-4 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 mb-8 transition-all shadow-md"
    >
      <div class="max-w-7xl mx-auto space-y-3">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <!-- Search Input -->
          <div class="relative flex-1 max-w-md">
            <input
              type="text"
              id="roster-search"
              placeholder="Search by skater name or #number..."
              class="w-full px-4 py-2 pl-9 bg-[#1A1A1A] border border-[#333] rounded-lg text-sm text-white placeholder-gray-500 focus:outline-none focus:border-[#E5A93C] transition-colors"
            />
            <span class="absolute left-3 top-2.5 text-gray-500 text-xs pointer-events-none">🔍</span>
          </div>

          <!-- Sort Selector -->
          <div class="flex items-center justify-end gap-2">
            <label for="roster-sort" class="text-xs text-gray-400 font-medium whitespace-nowrap">Sort:</label>
            <select
              id="roster-sort"
              class="bg-[#1A1A1A] border border-[#333] text-gray-300 text-xs rounded-md px-2.5 py-1.5 focus:outline-none focus:border-[#E5A93C]"
            >
              <option value="number">Jersey # (0-9)</option>
              <option value="name">Name (A-Z)</option>
            </select>
          </div>
        </div>

        <!-- Position Filter Pills -->
        <div class="flex flex-wrap items-center gap-2 overflow-x-auto pb-1 pt-1">
          <button
            type="button"
            data-filter="all"
            class="roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#541221] text-white border-[#7A1A30]"
          >
            All
          </button>
          <button
            type="button"
            data-filter="Jammer"
            class="roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
          >
            Jammers
          </button>
          <button
            type="button"
            data-filter="Blocker"
            class="roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
          >
            Blockers
          </button>
          <button
            type="button"
            data-filter="Pivot"
            class="roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
          >
            Pivots
          </button>
          <button
            type="button"
            data-filter="Official"
            class="roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
          >
            Officials &amp; Refs
          </button>
          {
            coaches.length > 0 && (
              <button
                type="button"
                data-filter="Coach"
                class="roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500"
              >
                Coaches
              </button>
            )
          }
          {
            freshMeat.length > 0 && (
              <button
                type="button"
                data-filter="Fresh Meat"
                class="roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-emerald-400 border-[#333] hover:border-emerald-500"
              >
                Fresh Meat
              </button>
            )
          }
        </div>
      </div>
    </div>

    <!-- Active Count Counter Indicator -->
    <div class="flex items-center justify-between text-xs text-gray-400 mb-4 px-1">
      <span>
        Showing <strong id="visible-count" class="text-[#E5A93C] font-mono">{roster.length}</strong> of <strong class="text-white font-mono">{roster.length}</strong> cards
      </span>
      <span class="text-gray-500 text-[11px] hidden sm:inline">
        Click any card to inspect full bio
      </span>
    </div>

    <!-- Empty State -->
    <div
      id="roster-empty"
      class="hidden bg-[#181818] border border-[#2A2A2A] rounded-2xl p-12 text-center space-y-3 my-8"
    >
      <div class="text-4xl">🛼</div>
      <h3 class="font-heading text-2xl uppercase tracking-wider text-white">No Skaters Found</h3>
      <p class="text-gray-400 text-sm max-w-md mx-auto">
        No roster members match your search or filter criteria.
      </p>
      <button
        type="button"
        id="reset-filters"
        class="inline-block mt-2 px-4 py-2 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase text-xs tracking-wider rounded transition-colors"
      >
        Reset Filters
      </button>
    </div>

    <!-- Roster Grid with Uniform Heights -->
    <div
      id="roster-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 auto-rows-fr"
    >
      {
        roster.map((member, index) => (
          <DerbyCard member={member} index={index} />
        ))
      }
    </div>

    <!-- Floating Back to Top Button -->
    <button
      type="button"
      id="back-to-top"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-40 bg-[#541221] hover:bg-[#7A1A30] text-white p-3 rounded-full shadow-2xl border border-[#9E1F3D] opacity-0 pointer-events-none transition-all duration-300 translate-y-2 hover:scale-110"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>

    <!-- Recruitment CTA -->
    <div
      class="mt-16 bg-[#181818] p-8 sm:p-12 rounded-2xl border border-[#2E2E2E] text-center space-y-4 shadow-xl"
    >
      <h2 class="font-heading text-4xl sm:text-5xl uppercase tracking-wider text-white">
        Want to skate with BARD?
      </h2>
      <p class="text-gray-300 text-base max-w-xl mx-auto">
        We teach complete beginners how to skate, hit, and play derby safely. Referees and
        non-skating officials are also in high demand!
      </p>
      <div class="pt-2">
        <a
          href="/join"
          class="inline-block px-8 py-3.5 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase tracking-wider text-lg rounded-md transition-colors"
        >
          Join Fresh Meat Clinic &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- Large Card Inspection Modal -->
  <div
    id="derby-card-modal"
    class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-card-name"
  >
    <div
      id="modal-card-dialog"
      class="relative w-full max-w-lg bg-gradient-to-b from-[#1C1C1C] via-[#161616] to-[#121212] rounded-3xl border-2 border-[#E5A93C] p-6 sm:p-8 shadow-[0_25px_60px_rgba(0,0,0,0.9),0_0_30px_rgba(229,169,60,0.25)] text-white space-y-5"
    >
      <!-- Close Button -->
      <button
        type="button"
        id="modal-close-btn"
        aria-label="Close card modal"
        class="absolute top-4 right-4 text-gray-400 hover:text-white bg-[#252525] hover:bg-[#541221] w-10 h-10 rounded-full flex items-center justify-center text-xl transition-all shadow-md z-30"
      >
        ✕
      </button>

      <!-- Modal Card Top Bar -->
      <div class="flex items-center justify-between gap-3 pr-12 pb-3 border-b border-[#2A2A2A]">
        <div>
          <span class="text-[10px] font-mono text-[#E5A93C] uppercase tracking-widest block mb-0.5">
            BROOKINGS AREA ROLLER DERBY • 2026 EDITION
          </span>
          <h2
            id="modal-card-name"
            class="font-heading text-3xl sm:text-4xl text-white uppercase tracking-wide leading-none"
          >
          </h2>
        </div>
        <div id="modal-card-number-wrapper" class="flex-shrink-0">
          <span
            id="modal-card-number"
            class="font-heading text-3xl sm:text-4xl text-[#E5A93C] font-bold"
          ></span>
        </div>
      </div>

      <!-- Modal Card Art Frame -->
      <div class="relative w-full aspect-[4/3] bg-[#0E0E0E] rounded-xl overflow-hidden border border-[#333] shadow-inner flex items-center justify-center">
        <img
          id="modal-card-photo"
          src=""
          alt=""
          class="w-full h-full object-cover object-top"
        />
        <div class="absolute bottom-3 left-3 z-10">
          <span
            id="modal-card-badge"
            class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#541221] text-white font-heading text-sm tracking-wider uppercase rounded-md shadow-lg border border-[#7A1A30]"
          ></span>
        </div>
        <div class="absolute top-3 right-3 z-10">
          <span class="px-2.5 py-0.5 bg-black/80 text-[#E5A93C] font-mono text-[10px] font-bold uppercase tracking-widest rounded border border-white/10">
            OFFICIAL BARD CARD
          </span>
        </div>
      </div>

      <!-- Modal Card Details -->
      <div class="space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
          <div id="modal-card-positions" class="flex flex-wrap gap-1.5"></div>
          <span id="modal-card-role" class="text-gray-400 font-mono text-[11px] uppercase tracking-wider"></span>
        </div>

        <div class="bg-[#151515] p-4 rounded-xl border border-[#262626] max-h-48 overflow-y-auto">
          <p
            id="modal-card-bio"
            class="text-sm text-gray-200 leading-relaxed font-sans"
          ></p>
        </div>
      </div>

      <!-- Modal Bottom Navigation Controls -->
      <div class="pt-3 border-t border-[#2A2A2A] flex items-center justify-between gap-3">
        <button
          type="button"
          id="modal-prev-btn"
          class="px-4 py-2 bg-[#222] hover:bg-[#541221] text-gray-200 hover:text-white font-heading text-sm uppercase tracking-wider rounded-md border border-[#3A3A3A] transition-colors inline-flex items-center gap-1.5 cursor-pointer"
        >
          ❮ Previous
        </button>
        <span id="modal-card-counter" class="text-xs font-mono text-gray-400"></span>
        <button
          type="button"
          id="modal-next-btn"
          class="px-4 py-2 bg-[#222] hover:bg-[#541221] text-gray-200 hover:text-white font-heading text-sm uppercase tracking-wider rounded-md border border-[#3A3A3A] transition-colors inline-flex items-center gap-1.5 cursor-pointer"
        >
          Next ❯
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupRosterSPA() {
    const searchInput = document.getElementById('roster-search') as HTMLInputElement | null;
    const sortSelect = document.getElementById('roster-sort') as HTMLSelectElement | null;
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.roster-filter-btn'));
    const grid = document.getElementById('roster-grid');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.roster-card'));
    const visibleCount = document.getElementById('visible-count');
    const emptyState = document.getElementById('roster-empty');
    const resetBtn = document.getElementById('reset-filters');
    const backToTopBtn = document.getElementById('back-to-top');

    // Modal elements
    const modal = document.getElementById('derby-card-modal');
    const closeBtn = document.getElementById('modal-close-btn');
    const prevBtn = document.getElementById('modal-prev-btn');
    const nextBtn = document.getElementById('modal-next-btn');
    const modalName = document.getElementById('modal-card-name');
    const modalNumber = document.getElementById('modal-card-number');
    const modalPhoto = document.getElementById('modal-card-photo') as HTMLImageElement | null;
    const modalBadge = document.getElementById('modal-card-badge');
    const modalPositions = document.getElementById('modal-card-positions');
    const modalRole = document.getElementById('modal-card-role');
    const modalBio = document.getElementById('modal-card-bio');
    const modalCounter = document.getElementById('modal-card-counter');

    let activeFilter = 'all';
    let searchQuery = '';
    let currentModalIndex = 0;

    function getVisibleCards(): HTMLElement[] {
      return cards.filter((card) => card.style.display !== 'none');
    }

    function sortAndFilterCards() {
      let visible = 0;
      const sortBy = sortSelect?.value ?? 'number';

      // Sort
      const sorted = [...cards].sort((a, b) => {
        if (sortBy === 'name') {
          return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
        }
        const numA = a.dataset.number ?? '';
        const numB = b.dataset.number ?? '';
        if (!numA && numB) return 1;
        if (numA && !numB) return -1;
        return numA.localeCompare(numB, undefined, { numeric: true, sensitivity: 'base' });
      });

      if (grid) {
        for (const card of sorted) {
          grid.appendChild(card);
        }
      }

      // Filter
      for (const card of cards) {
        const name = card.dataset.name ?? '';
        const number = card.dataset.number ?? '';
        const positions = (card.dataset.positions ?? '').split(',');
        const isOfficial = card.dataset.isOfficial === 'true';

        const matchesSearch =
          !searchQuery ||
          name.includes(searchQuery) ||
          number.includes(searchQuery);

        let matchesFilter = true;
        if (activeFilter === 'all') {
          matchesFilter = true;
        } else if (activeFilter === 'Official') {
          matchesFilter = isOfficial;
        } else {
          matchesFilter = positions.includes(activeFilter);
        }

        if (matchesSearch && matchesFilter) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      }

      if (visibleCount) visibleCount.textContent = String(visible);
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    // Modal display logic
    function openModalForCard(card: HTMLElement) {
      const visibleCards = getVisibleCards();
      const idx = visibleCards.indexOf(card);
      if (idx === -1) return;
      currentModalIndex = idx;
      renderModalContent();
      if (modal) {
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
    }

    function renderModalContent() {
      const visibleCards = getVisibleCards();
      if (visibleCards.length === 0) return;
      if (currentModalIndex < 0) currentModalIndex = visibleCards.length - 1;
      if (currentModalIndex >= visibleCards.length) currentModalIndex = 0;

      const card = visibleCards[currentModalIndex];
      if (!card) return;

      const name = card.dataset.cardName || '';
      const number = card.dataset.cardNumber || '';
      const positions = (card.dataset.cardPositions || '').split(',').map((p) => p.trim()).filter(Boolean);
      const bio = card.dataset.cardBio || 'Active skater with Brookings Area Roller Derby.';
      const role = card.dataset.cardRole || 'BARD Member';

      // Find photo element in card
      const img = card.querySelector('img') as HTMLImageElement | null;
      const photoSrc = img ? img.src : '';

      if (modalName) modalName.textContent = name;
      if (modalNumber) modalNumber.textContent = number ? `#${number}` : 'COACH';
      if (modalPhoto) {
        modalPhoto.src = photoSrc;
        modalPhoto.alt = `${name} trading card portrait`;
      }
      if (modalBadge) {
        modalBadge.textContent = positions[0] || 'Skater';
      }
      if (modalRole) modalRole.textContent = role;
      if (modalBio) modalBio.textContent = bio;
      if (modalCounter) {
        modalCounter.textContent = `${currentModalIndex + 1} of ${visibleCards.length}`;
      }

      if (modalPositions) {
        modalPositions.innerHTML = '';
        for (const pos of positions) {
          const badge = document.createElement('span');
          badge.className = 'px-2 py-0.5 text-xs font-mono font-bold uppercase tracking-wider rounded bg-[#202020] text-[#E5A93C] border border-[#3E2D32]';
          badge.textContent = pos;
          modalPositions.appendChild(badge);
        }
      }
    }

    // Attach card click handlers
    for (const card of cards) {
      card.addEventListener('click', () => {
        openModalForCard(card);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModalForCard(card);
        }
      });
    }

    // Modal controls
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentModalIndex--;
        renderModalContent();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentModalIndex++;
        renderModalContent();
      });
    }

    // Click outside modal dialog to close
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        closeModal();
      } else if (e.key === 'ArrowLeft') {
        currentModalIndex--;
        renderModalContent();
      } else if (e.key === 'ArrowRight') {
        currentModalIndex++;
        renderModalContent();
      }
    });

    // Toolbar listeners
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        sortAndFilterCards();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        sortAndFilterCards();
      });
    }

    for (const btn of filterButtons) {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.filter ?? 'all';

        for (const b of filterButtons) {
          b.className =
            'roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#1E1E1E] text-gray-300 border-[#333] hover:border-gray-500';
        }
        btn.className =
          'roster-filter-btn px-3.5 py-1.5 text-xs font-heading uppercase tracking-wider rounded-md border transition-all bg-[#541221] text-white border-[#7A1A30]';

        sortAndFilterCards();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeFilter = 'all';
        for (const b of filterButtons) {
          if (b.dataset.filter === 'all') {
            b.click();
          }
        }
      });
    }

    // Scroll listener for floating Back-to-Top button
    if (backToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
          backToTopBtn.classList.add('opacity-100', 'translate-y-0');
        } else {
          backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
          backToTopBtn.classList.remove('opacity-100', 'translate-y-0');
        }
      });

      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Initial sort
    sortAndFilterCards();
  }

  setupRosterSPA();
</script>
