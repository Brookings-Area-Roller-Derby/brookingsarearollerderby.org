---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { siteConfig } from '../config/site';
import { normalizeImageUrl } from '../lib/images';

const sponsors = await getCollection('sponsors', ({ data }) => data.active);
const grandSlamSponsors = sponsors.filter((s) => s.data.tier === 'grand-slam');
const apexJumpSponsors = sponsors.filter((s) => s.data.tier === 'apex-jump');
const rookieSponsors = sponsors.filter((s) => s.data.tier === 'rookie');
const exclusiveSponsors = sponsors.filter((s) => s.data.tier === 'exclusive');

const packetInquiry = `mailto:${siteConfig.email}?subject=Inquiry%20About%20BARD%20Sponsorship%20Packet`;

const tiers = [
  {
    id: 'grand-slam',
    name: 'Grand Slam Sponsor',
    price: '$300 Contribution',
    color: 'border-[#E5A93C] bg-[#1E1B13]',
    badge: 'bg-[#E5A93C] text-black',
    perks: [
      '6 season home tickets ($180 value)',
      '8 dedicated Facebook mentions & promo posts',
      'Banner display at all home bouts (sponsor provides banner)',
      'Quarter-page ad in official printed bout program',
      'Live announcer sponsorship mentions at all home bouts',
    ],
  },
  {
    id: 'apex-jump',
    name: 'Apex Jump Sponsor',
    price: '$200 Contribution',
    color: 'border-[#9E1F3D] bg-[#221015]',
    badge: 'bg-[#9E1F3D] text-white',
    perks: [
      '4 season home tickets ($120 value)',
      '4 dedicated Facebook mentions & promo posts',
      'Banner display at all home bouts (sponsor provides banner)',
      'Eighth-page ad in official printed bout program',
      'Live announcer sponsorship mentions at home bouts',
    ],
  },
  {
    id: 'rookie',
    name: 'Rookie Sponsor',
    price: '$100 Contribution',
    color: 'border-gray-600 bg-[#1B1B1B]',
    badge: 'bg-gray-700 text-gray-200',
    perks: [
      '2 season home tickets ($60 value)',
      '2 dedicated Facebook mentions & promo posts',
      'Banner display at all home bouts (sponsor provides banner)',
      'Logo in official printed bout program',
      'Live announcer sponsorship mentions at home bouts',
    ],
  },
  {
    id: 'exclusive',
    name: 'Exclusive Packages',
    price: '$500 Each',
    color: 'border-[#541221] bg-[#181818]',
    badge: 'bg-[#541221] text-[#E5A93C]',
    perks: [
      'Only one sponsor available per exclusive package',
      'Jammer Package: Grand Slam package + Jam Line Sponsor for all home bouts',
      'Blocker Package: Grand Slam package + Penalty Box Sponsor for all home bouts',
      'Bench Coach Package: Grand Slam package + Danger Zone Seating Sponsor for all home bouts',
      'Includes 6 home tickets ($180 value), 8 FB mentions, banner, 1/4 page ad & live announcements',
    ],
  },
];
---

<Layout
  title="Sponsor the League"
  description="Support Brookings Area Roller Derby (BARD). View our 501(c)(3) tax-deductible sponsorship tiers and partner packages."
>
  <!-- Header Banner -->
  <section class="bg-grunge py-14 border-b-4 border-[#541221]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span
        class="inline-block px-3 py-1 bg-[#3B0B16] text-[#E5A93C] font-heading uppercase text-xs tracking-widest rounded mb-3"
      >
        501(c)(3) Non-Profit Partnership
      </span>
      <h1 class="font-heading text-5xl sm:text-7xl uppercase tracking-wider text-white">
        Sponsorship Packages
      </h1>
      <p class="text-gray-400 text-lg max-w-2xl mt-2">
        Partner with Eastern South Dakota's premier flat-track roller derby league. Put your brand
        directly in front of hundreds of energetic local fans.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">
    <!-- Why Sponsor Section -->
    <div class="bg-[#1B1B1B] border border-[#3B0B16] rounded-xl p-8 sm:p-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center sm:text-left">
        <div>
          <span class="font-heading text-4xl text-[#E5A93C] block mb-1">501(c)(3)</span>
          <h3 class="font-heading text-xl text-white uppercase tracking-wider mb-2">
            Tax-Deductible
          </h3>
          <p class="text-sm text-gray-400">
            Registered 501(c)(3) non-profit and the only open gender flat track roller derby team in
            the Brookings area.
          </p>
        </div>
        <div>
          <span class="font-heading text-4xl text-[#E5A93C] block mb-1">125–200</span>
          <h3 class="font-heading text-xl text-white uppercase tracking-wider mb-2">
            Bout Attendance
          </h3>
          <p class="text-sm text-gray-400">
            Average attendees per home bout, drawing passionate sports fans and families from across
            SD, MN, ND, and IA.
          </p>
        </div>
        <div>
          <span class="font-heading text-4xl text-[#E5A93C] block mb-1">1,700+</span>
          <h3 class="font-heading text-xl text-white uppercase tracking-wider mb-2">
            Social Followers
          </h3>
          <p class="text-sm text-gray-400">
            Active digital fan community with dedicated sponsor shout-outs, promotional graphics,
            and online visibility.
          </p>
        </div>
        <div>
          <span class="font-heading text-4xl text-[#E5A93C] block mb-1">2nd Place</span>
          <h3 class="font-heading text-xl text-white uppercase tracking-wider mb-2">
            MRDA Tournament
          </h3>
          <p class="text-sm text-gray-400">
            Sanctioned MRDA team playing by WFTDA rules; recently took 2nd place at the national
            Clover Cup in Dallas, TX!
          </p>
        </div>
      </div>
    </div>

    <!-- Tiers Grid -->
    <div>
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="font-heading text-4xl sm:text-5xl uppercase tracking-wider text-white mb-3">
          {siteConfig.season} Sponsorship Tiers
        </h2>
        <p class="text-gray-400 text-sm sm:text-base">
          Choose the package that fits your organization, or contact us for custom in-kind equipment
          trades.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          tiers.map((tier) => (
            <div
              class={`rounded-xl border-2 ${tier.color} p-6 flex flex-col justify-between shadow-2xl relative`}
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span
                    class={`px-2.5 py-1 text-xs font-heading uppercase tracking-widest rounded font-bold ${tier.badge}`}
                  >
                    {tier.name.split(' ')[0]} Tier
                  </span>
                </div>

                <h3 class="font-heading text-2xl text-white uppercase tracking-wider mb-1">
                  {tier.name}
                </h3>

                <div class="font-heading text-3xl text-[#E5A93C] tracking-wide mb-6">
                  {tier.price}
                </div>

                <div class="border-t border-[#3B0B16] pt-4 mb-6">
                  <p class="text-xs uppercase font-subheading text-gray-400 font-bold mb-3 tracking-wider">
                    Included Benefits:
                  </p>
                  <ul class="space-y-2.5 text-xs text-gray-300">
                    {tier.perks.map((perk) => (
                      <li class="flex items-start gap-2">
                        <span class="text-[#E5A93C] font-bold">✓</span>
                        <span>{perk}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="pt-4 border-t border-[#282828]">
                <a
                  href={`mailto:${siteConfig.email}?subject=${encodeURIComponent(`BARD Sponsorship Inquiry - ${tier.name}`)}`}
                  class="block w-full py-2.5 text-center bg-[#3B0B16] hover:bg-[#541221] text-white font-heading uppercase text-sm tracking-wider rounded border border-[#7A1A30] transition-colors"
                >
                  Select {tier.name.split(' ')[0]} Package
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Sponsor Packet Download & Action Box -->
    <div
      class="bg-gradient-to-r from-[#1B1B1B] via-[#3B0B16] to-[#1B1B1B] border-2 border-[#E5A93C] rounded-2xl p-8 sm:p-12 text-center space-y-6 shadow-2xl"
    >
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#3B0B16] border border-[#E5A93C]/40 text-[#E5A93C] font-heading uppercase tracking-widest text-xs rounded-full"
      >
        📄 Official {siteConfig.season} Partnership Form
      </div>
      <h2 class="font-heading text-3xl sm:text-5xl uppercase tracking-wider text-white">
        Download {siteConfig.season} Sponsorship Agreement
      </h2>
      <p class="text-gray-200 text-base max-w-2xl mx-auto leading-relaxed">
        Download our official partnership document and agreement form. Includes full package
        breakdown, ticket benefits, banner requirements, and sign-off form.
      </p>

      <!-- 2026 Home Game Dates Highlight -->
      <div class="bg-[#121212]/80 border border-[#333] rounded-xl p-4 max-w-2xl mx-auto">
        <span class="text-xs uppercase font-mono text-[#E5A93C] font-bold block mb-1">
          🗓️ 2026 BARD Home Bouts Schedule
        </span>
        <p class="text-sm text-gray-300">February 14 • July 11 • August 29 • September 26</p>
      </div>

      <div class="flex flex-wrap justify-center items-center gap-4 pt-2">
        <a
          href="/2026-sponsor-packet.pdf"
          download="BARD-2026-Sponsor-Packet.pdf"
          target="_blank"
          class="px-8 py-4 bg-[#E5A93C] hover:bg-[#d6982b] text-black font-heading uppercase tracking-wider text-lg rounded-xl font-bold shadow-xl transition-transform active:scale-95 flex items-center gap-2.5"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
            <path d="M13 8V2H7v6H2l8 8 8-8h-5zM0 18h20v2H0v-2z"></path>
          </svg>
          Download Sponsor Packet (PDF)
        </a>
        <a
          href={packetInquiry}
          class="px-8 py-4 bg-[#141414] hover:bg-[#252525] text-white font-heading uppercase tracking-wider text-lg rounded-xl border border-gray-600 transition-colors flex items-center gap-2"
        >
          ✉️ Email: {siteConfig.email}
        </a>
      </div>
      <p class="text-xs text-gray-400 max-w-lg mx-auto">
        Completed agreements and high-resolution logo artwork can be sent directly to{' '}
        <a href={`mailto:${siteConfig.email}`} class="text-[#E5A93C] underline">
          {siteConfig.email}
        </a>.
      </p>
    </div>

    <!-- Current Active Sponsors List -->
    {
      sponsors.length > 0 && (
        <div class="pt-12 border-t border-[#3B0B16] space-y-12">
          <div class="text-center max-w-2xl mx-auto">
            <span class="inline-block px-3 py-1 bg-[#3B0B16] text-[#E5A93C] font-heading uppercase text-xs tracking-widest rounded mb-3">
              Our Community Backers
            </span>
            <h3 class="font-heading text-4xl sm:text-5xl uppercase tracking-wider text-white">
              Current League Partners &amp; Sponsors
            </h3>
            <p class="text-gray-400 text-sm mt-2">
              Huge thanks to the local businesses keeping roller derby thriving in Brookings!
            </p>
          </div>

          {/* Grand Slam Tier (Featured Large Cards) */}
          {grandSlamSponsors.length > 0 && (
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="px-3 py-1 text-xs font-heading uppercase tracking-wider bg-[#E5A93C] text-black font-bold rounded">
                  Grand Slam Tier
                </span>
                <span class="h-px flex-1 bg-gradient-to-r from-[#E5A93C]/40 to-transparent" />
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {grandSlamSponsors.map((s) => (
                  <div class="bg-gradient-to-br from-[#1E1B13] to-[#141414] border-2 border-[#E5A93C] rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row gap-6 items-center sm:items-start justify-between shadow-2xl relative overflow-hidden group hover:border-[#F2BE63] transition-all">
                    {s.data.logo && (
                      <div class="w-36 h-28 sm:w-44 sm:h-32 flex-shrink-0 bg-white rounded-xl p-3 flex items-center justify-center shadow-inner border border-white/20">
                        {typeof s.data.logo === 'string' ? (
                          <img
                            src={normalizeImageUrl(s.data.logo)}
                            alt={`${s.data.name} logo`}
                            class="w-full h-full object-contain"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <Image
                            src={s.data.logo}
                            alt={`${s.data.name} logo`}
                            class="w-full h-full object-contain"
                          />
                        )}
                      </div>
                    )}
                    <div class="flex-1 text-center sm:text-left flex flex-col justify-between h-full space-y-3">
                      <div>
                        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1.5">
                          <span class="text-[11px] font-heading uppercase tracking-widest text-[#E5A93C] bg-[#3B0B16] px-2.5 py-0.5 rounded font-bold">
                            Premier Partner
                          </span>
                        </div>
                        <h4 class="font-heading text-2xl sm:text-3xl text-white uppercase tracking-wider leading-tight">
                          {s.data.name}
                        </h4>
                        {s.body && (
                          <p class="text-sm text-gray-300 mt-2.5 leading-relaxed font-sans">
                            {s.body}
                          </p>
                        )}
                      </div>
                      {s.data.url && (
                        <div class="pt-2">
                          <a
                            href={s.data.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 px-5 py-2 bg-[#E5A93C] hover:bg-[#d6982b] text-black font-heading uppercase text-xs tracking-wider rounded font-bold transition-all shadow"
                          >
                            Visit Partner Website &rarr;
                          </a>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Apex Jump Tier (Medium Cards) */}
          {apexJumpSponsors.length > 0 && (
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="px-3 py-1 text-xs font-heading uppercase tracking-wider bg-[#9E1F3D] text-white font-bold rounded">
                  Apex Jump Tier
                </span>
                <span class="h-px flex-1 bg-gradient-to-r from-[#9E1F3D]/40 to-transparent" />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {apexJumpSponsors.map((s) => (
                  <div class="bg-gradient-to-br from-[#221015] to-[#151515] border border-[#9E1F3D] hover:border-red-500 rounded-xl p-6 flex flex-col justify-between shadow-lg transition-all">
                    <div class="space-y-4">
                      {s.data.logo && (
                        <div class="w-full h-24 bg-white rounded-lg p-2.5 flex items-center justify-center shadow-inner">
                          {typeof s.data.logo === 'string' ? (
                            <img
                              src={normalizeImageUrl(s.data.logo)}
                              alt={`${s.data.name} logo`}
                              class="w-full h-full object-contain"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <Image
                              src={s.data.logo}
                              alt={`${s.data.name} logo`}
                              class="w-full h-full object-contain"
                            />
                          )}
                        </div>
                      )}
                      <div>
                        <h4 class="font-heading text-xl text-white uppercase tracking-wider">
                          {s.data.name}
                        </h4>
                        {s.body && (
                          <p class="text-xs text-gray-300 mt-2 leading-relaxed font-sans">
                            {s.body}
                          </p>
                        )}
                      </div>
                    </div>
                    {s.data.url && (
                      <div class="pt-4 mt-4 border-t border-[#3B0B16]">
                        <a
                          href={s.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-xs font-heading uppercase text-red-400 hover:text-red-300 tracking-wider inline-flex items-center gap-1"
                        >
                          Visit Partner &rarr;
                        </a>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Rookie Tier (Compact Cards) */}
          {rookieSponsors.length > 0 && (
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="px-3 py-1 text-xs font-heading uppercase tracking-wider bg-gray-700 text-gray-200 font-bold rounded">
                  Rookie Tier
                </span>
                <span class="h-px flex-1 bg-gradient-to-r from-gray-700/40 to-transparent" />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
                {rookieSponsors.map((s) => (
                  <div class="bg-[#181818] border border-[#2E2E2E] hover:border-gray-500 rounded-xl p-5 flex flex-col justify-between shadow transition-all">
                    <div>
                      {s.data.logo && (
                        <div class="w-full h-16 bg-white/90 rounded-md p-1.5 mb-3 flex items-center justify-center">
                          {typeof s.data.logo === 'string' ? (
                            <img
                              src={normalizeImageUrl(s.data.logo)}
                              alt={`${s.data.name} logo`}
                              class="w-full h-full object-contain"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <Image
                              src={s.data.logo}
                              alt={`${s.data.name} logo`}
                              class="w-full h-full object-contain"
                            />
                          )}
                        </div>
                      )}
                      <h4 class="font-heading text-lg text-white uppercase tracking-wider">
                        {s.data.name}
                      </h4>
                      {s.body && (
                        <p class="text-xs text-gray-400 mt-1.5 leading-relaxed font-sans">
                          {s.body}
                        </p>
                      )}
                    </div>
                    {s.data.url && (
                      <div class="pt-3 mt-3 border-t border-[#252525]">
                        <a
                          href={s.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-[11px] font-heading uppercase text-gray-400 hover:text-white tracking-wider inline-flex items-center gap-1"
                        >
                          Visit Partner &rarr;
                        </a>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Custom / Exclusive Tier (if any) */}
          {exclusiveSponsors.length > 0 && (
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="px-3 py-1 text-xs font-heading uppercase tracking-wider bg-[#541221] text-[#E5A93C] font-bold rounded">
                  Exclusive / Title Sponsors
                </span>
                <span class="h-px flex-1 bg-gradient-to-r from-[#541221] to-transparent" />
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {exclusiveSponsors.map((s) => (
                  <div class="bg-[#1B1B1B] border-2 border-[#541221] rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row gap-6 items-center sm:items-start justify-between shadow-xl">
                    {s.data.logo && (
                      <div class="w-36 h-28 flex-shrink-0 bg-white rounded-xl p-3 flex items-center justify-center shadow-inner">
                        {typeof s.data.logo === 'string' ? (
                          <img
                            src={normalizeImageUrl(s.data.logo)}
                            alt={`${s.data.name} logo`}
                            class="w-full h-full object-contain"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <Image
                            src={s.data.logo}
                            alt={`${s.data.name} logo`}
                            class="w-full h-full object-contain"
                          />
                        )}
                      </div>
                    )}
                    <div class="flex-1 text-center sm:text-left flex flex-col justify-between h-full space-y-3">
                      <div>
                        <h4 class="font-heading text-2xl text-white uppercase tracking-wider">
                          {s.data.name}
                        </h4>
                        {s.body && (
                          <p class="text-sm text-gray-300 mt-2 leading-relaxed font-sans">
                            {s.body}
                          </p>
                        )}
                      </div>
                      {s.data.url && (
                        <a
                          href={s.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 px-5 py-2 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading uppercase text-xs tracking-wider rounded border border-[#9E1F3D]"
                        >
                          Visit Partner &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )
    }
  </div>
</Layout>
