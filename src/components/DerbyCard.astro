---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import defaultLogo from '../assets/logo.jpg';
import { normalizeImageUrl } from '../lib/images';

interface Props {
  member: CollectionEntry<'roster'>;
  index: number;
}

const { member, index } = Astro.props;

const primaryPosition = member.data.positions[0] ?? 'Skater';

let posBadgeColor = 'bg-[#222] text-gray-200 border-[#444]';
let posIcon = '🛡️';

if (member.data.positions.includes('Jammer')) {
  posBadgeColor = 'bg-[#541221] text-white border-[#7A1A30]';
  posIcon = '★';
} else if (member.data.positions.includes('Pivot')) {
  posBadgeColor = 'bg-[#3B0B16] text-red-300 border-[#7A1A30]';
  posIcon = '⚡';
} else if (member.data.positions.includes('Coach')) {
  posBadgeColor = 'bg-[#1E1E1E] text-[#E5A93C] border-[#E5A93C]/40';
  posIcon = '📋';
} else if (member.data.positions.includes('Ref') || member.data.positions.includes('NSO')) {
  posBadgeColor = 'bg-[#1E1E1E] text-[#E5A93C] border-[#E5A93C]/40';
  posIcon = '⚖️';
} else if (member.data.positions.includes('Fresh Meat')) {
  posBadgeColor = 'bg-[#0F291E] text-emerald-400 border-emerald-500/40';
  posIcon = '🌱';
}
---

<article
  class="roster-card derby-trading-card bg-gradient-to-b from-[#1C1C1C] via-[#161616] to-[#121212] rounded-2xl border-2 border-[#2A2A2A] hover:border-[#E5A93C] overflow-hidden shadow-xl hover:shadow-[0_12px_35px_rgba(229,169,60,0.22)] transition-all duration-300 flex flex-col justify-between group relative cursor-pointer min-h-[480px] select-none"
  data-name={member.data.derbyName.toLowerCase()}
  data-number={member.data.number ? member.data.number.toLowerCase() : ''}
  data-positions={member.data.positions.join(',')}
  data-is-official={member.data.positions.some((p) => p === 'Ref' || p === 'NSO') ? 'true' : 'false'}
  data-card-index={index}
  data-card-name={member.data.derbyName}
  data-card-number={member.data.number || ''}
  data-card-photo={typeof member.data.photo === 'string' ? member.data.photo : ''}
  data-card-positions={member.data.positions.join(', ')}
  data-card-bio={member.body || ''}
  data-card-role={member.data.positions.includes('Fresh Meat')
    ? 'BARD Fresh Meat'
    : member.data.positions.includes('Coach')
      ? 'BARD Bench Coach'
      : member.data.positions.some((p) => p === 'Ref' || p === 'NSO')
        ? 'BARD Official'
        : 'BARD Active Skater'}
  role="button"
  tabindex="0"
  aria-label={`Inspect ${member.data.derbyName} trading card`}
>
  <!-- Holographic Foil Sheen (Active on Hover) -->
  <div class="derby-foil-sheen absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl z-20 pointer-events-none" aria-hidden="true"></div>

  <!-- Top Card Header -->
  <div class="p-4 pb-3 flex items-center justify-between gap-2 border-b border-[#252525] bg-[#141414]/90 relative z-10">
    <h3 class="font-heading text-2xl sm:text-3xl text-white uppercase tracking-wider truncate group-hover:text-[#E5A93C] transition-colors">
      {member.data.derbyName}
    </h3>
    {
      member.data.number ? (
        <span class="font-heading text-2xl sm:text-3xl text-[#E5A93C] font-bold tracking-wider flex-shrink-0">
          #{member.data.number}
        </span>
      ) : (
        <span class="px-2 py-0.5 bg-[#1F1F1F] text-[#E5A93C] font-mono text-[11px] font-bold uppercase tracking-wider rounded border border-[#E5A93C]/40 flex-shrink-0">
          COACH
        </span>
      )
    }
  </div>

  <!-- Card Portrait Frame -->
  <div class="relative w-full aspect-[4/3] bg-[#0E0E0E] overflow-hidden border-y border-[#262626] flex items-center justify-center">
    {
      typeof member.data.photo === 'string' ? (
        <img
          src={normalizeImageUrl(member.data.photo)}
          alt={member.data.number ? `${member.data.derbyName} - #${member.data.number}` : member.data.derbyName}
          class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500 ease-out"
          loading="lazy"
          decoding="async"
        />
      ) : member.data.photo ? (
        <Image
          src={member.data.photo}
          alt={member.data.number ? `${member.data.derbyName} - #${member.data.number}` : member.data.derbyName}
          class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500 ease-out"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center p-4 bg-gradient-to-b from-[#181818] to-[#0D0D0D]">
          <Image
            src={defaultLogo}
            alt="Brookings Area Roller Derby"
            class="w-20 h-20 object-contain opacity-85 group-hover:scale-110 transition-transform duration-300"
          />
          <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest mt-2 font-semibold">
            BARD OFFICIAL
          </span>
        </div>
      )
    }

    <!-- Position Badge in Art Corner -->
    <div class="absolute bottom-2.5 left-2.5 z-10">
      <span class={`inline-flex items-center gap-1 px-2.5 py-1 text-xs font-heading uppercase tracking-wider rounded-md shadow-md border ${posBadgeColor}`}>
        <span>{posIcon}</span>
        <span>{primaryPosition}</span>
      </span>
    </div>

    <!-- Official BARD Series Chip in Top Right Corner -->
    <div class="absolute top-2.5 right-2.5 z-10">
      <span class="px-2 py-0.5 bg-black/75 backdrop-blur-sm text-[#E5A93C] font-mono text-[9px] uppercase tracking-widest font-bold rounded border border-white/10">
        BARD 2026
      </span>
    </div>
  </div>

  <!-- Card Details & Body -->
  <div class="p-4 flex-1 flex flex-col justify-between space-y-3 relative z-10">
    <div>
      <!-- Team Subheader Strip -->
      <div class="flex items-center justify-between gap-2 mb-2 pb-1.5 border-b border-[#252525]">
        <span class="text-[10px] font-mono text-[#E5A93C] uppercase tracking-widest font-semibold">
          Brookings Area Roller Derby
        </span>
        <span class="text-[10px] font-mono text-gray-400 uppercase tracking-wider">
          Series 1
        </span>
      </div>

      <!-- Position Tags -->
      <div class="flex flex-wrap gap-1 mb-2.5">
        {
          member.data.positions.map((pos) => (
            <span class="px-2 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider rounded bg-[#202020] text-gray-300 border border-[#333]">
              {pos}
            </span>
          ))
        }
      </div>

      <!-- Biography Text -->
      {
        member.body ? (
          <p class="text-xs text-gray-300 leading-relaxed font-sans line-clamp-3">
            {member.body}
          </p>
        ) : (
          <p class="text-xs text-gray-500 italic font-sans">
            Active competitor with Brookings Area Roller Derby.
          </p>
        )
      }
    </div>

    <!-- Card Bottom Plaque -->
    <div class="pt-2 border-t border-[#222] flex items-center justify-between text-[10px] font-mono text-gray-400">
      <span>CARD #{String(index + 1).padStart(2, '0')}</span>
      <span class="text-[#E5A93C] group-hover:text-amber-300 font-sans font-semibold tracking-wider flex items-center gap-1 group-hover:underline uppercase text-[11px]">
        Inspect Card 🔍
      </span>
    </div>
  </div>
</article>
