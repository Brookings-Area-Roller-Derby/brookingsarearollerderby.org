---
import { siteConfig } from '../config/site';

export interface CountdownEvent {
  title: string;
  date: string;
  location: string;
}

interface Props {
  events: CountdownEvent[];
}

const { events } = Astro.props;
const sortedEvents = [...events].sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime(),
);
const initialEvent = sortedEvents.find((event) => new Date(event.date).getTime() > Date.now());

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-US', {
    timeZone: siteConfig.timeZone,
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(value));

const now = Date.now();
const target = initialEvent ? new Date(initialEvent.date).getTime() : now;
const initialDiff = Math.max(0, target - now);
const initialDays = Math.floor(initialDiff / 86_400_000);
const initialHours = Math.floor((initialDiff % 86_400_000) / 3_600_000);
const initialMinutes = Math.floor((initialDiff % 3_600_000) / 60_000);
const initialSeconds = Math.floor((initialDiff % 60_000) / 1_000);

const initialValues: Record<string, string> = {
  days: String(initialDays).padStart(2, '0'),
  hours: String(initialHours).padStart(2, '0'),
  minutes: String(initialMinutes).padStart(2, '0'),
  seconds: String(initialSeconds).padStart(2, '0'),
};
---

<section
  class="bg-[#181818] border border-[#2E2E2E] p-6 sm:p-8 rounded-xl shadow-2xl relative overflow-hidden"
  id="bout-countdown"
  data-events={JSON.stringify(sortedEvents)}
  data-time-zone={siteConfig.timeZone}
  aria-labelledby="countdown-title"
  hidden={!initialEvent}
>
  <div class="flex flex-col lg:flex-row items-center justify-between gap-6 relative z-10">
    <div class="text-center lg:text-left">
      <span
        class="inline-block px-3 py-1 bg-[#541221] text-white text-xs font-semibold tracking-wider uppercase rounded-full mb-2"
      >
        Next Upcoming Bout
      </span>
      <h2
        id="countdown-title"
        class="font-heading text-3xl sm:text-4xl text-white uppercase tracking-wide"
      >
        {initialEvent?.title}
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        <time id="countdown-date" datetime={initialEvent?.date}>
          {initialEvent ? formatDate(initialEvent.date) : ''}
        </time>
        <span id="countdown-location">{initialEvent ? ` • ${initialEvent.location}` : ''}</span>
      </p>
    </div>

    <div
      class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-center"
      aria-label="Time until the next bout"
    >
      {
        [
          ['days', 'Days'],
          ['hours', 'Hours'],
          ['minutes', 'Mins'],
          ['seconds', 'Secs'],
        ].map(([unit, label], index) => (
          <>
            {index > 0 && (
              <span class="font-heading text-2xl text-gray-500" aria-hidden="true">
                :
              </span>
            )}
            <div class="bg-[#101010] border border-[#2A2A2A] rounded-lg p-3 min-w-[64px] sm:min-w-[80px]">
              <span
                id={`countdown-${unit}`}
                class={`font-heading text-4xl sm:text-5xl block leading-none ${unit === 'seconds' ? 'text-red-500' : 'text-white'}`}
              >
                {initialValues[unit] ?? '00'}
              </span>
              <span class="text-[10px] font-sans text-gray-400 uppercase tracking-widest font-medium">
                {label}
              </span>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>

<script>
  interface CountdownEvent {
    title: string;
    date: string;
    location: string;
  }

  const container = document.getElementById('bout-countdown');
  let activeDate = '';

  const setText = (id: string, value: string) => {
    const element = document.getElementById(id);
    if (element) element.textContent = value;
  };

  function updateCountdown() {
    if (!(container instanceof HTMLElement)) return;

    const events = JSON.parse(container.dataset.events ?? '[]') as CountdownEvent[];
    const now = Date.now();
    const nextEvent = events.find((event) => new Date(event.date).getTime() > now);

    if (!nextEvent) {
      container.hidden = true;
      return;
    }

    container.hidden = false;
    const target = new Date(nextEvent.date).getTime();

    if (activeDate !== nextEvent.date) {
      activeDate = nextEvent.date;
      setText('countdown-title', nextEvent.title);
      setText('countdown-location', ` • ${nextEvent.location}`);

      const dateElement = document.getElementById('countdown-date');
      if (dateElement instanceof HTMLTimeElement) {
        dateElement.dateTime = nextEvent.date;
        dateElement.textContent = new Intl.DateTimeFormat('en-US', {
          timeZone: container.dataset.timeZone,
          weekday: 'long',
          month: 'long',
          day: 'numeric',
          year: 'numeric',
        }).format(new Date(nextEvent.date));
      }
    }

    const difference = Math.max(0, target - now);
    const days = Math.floor(difference / 86_400_000);
    const hours = Math.floor((difference % 86_400_000) / 3_600_000);
    const minutes = Math.floor((difference % 3_600_000) / 60_000);
    const seconds = Math.floor((difference % 60_000) / 1_000);

    setText('countdown-days', String(days).padStart(2, '0'));
    setText('countdown-hours', String(hours).padStart(2, '0'));
    setText('countdown-minutes', String(minutes).padStart(2, '0'));
    setText('countdown-seconds', String(seconds).padStart(2, '0'));
  }

  updateCountdown();
  window.setInterval(updateCountdown, 1_000);
</script>
