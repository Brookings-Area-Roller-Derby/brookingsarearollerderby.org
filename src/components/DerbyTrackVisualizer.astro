  const skaterDomIds: Record<SkaterKey, string> = {
    bardJammer: 'skater-bard-jammer',
    bardPivot: 'skater-bard-pivot',
    bardB1: 'skater-bard-b1',
    bardB2: 'skater-bard-b2',
    bardB3: 'skater-bard-b3',
    awayJammer: 'skater-away-jammer',
    awayPivot: 'skater-away-pivot',
    awayB1: 'skater-away-b1',
    awayB2: 'skater-away-b2',
    awayB3: 'skater-away-b3',
  };

  let currentStepIndex = 0;
  let isAutoPlaying = false;
  let autoPlayTimer: number | null = null;
  const STEP_AUTO_DELAY = 6000; // 6s per step

  // Animation Engine State
  let guidePathEl: SVGPathElement | null = null;
  let totalTrackLength = 1702;
  let animFrameId: number | null = null;

  // Track each skater's current rendering position (continuous distance & lane)
  const currentSkatersState: Record<SkaterKey, SkaterTrackState> = {
    bardJammer: { dist: 40, lane: 15 },
    bardPivot: { dist: 270, lane: 15 },
    bardB1: { dist: 225, lane: 15 },
    bardB2: { dist: 180, lane: 15 },
    bardB3: { dist: 135, lane: 15 },
    awayJammer: { dist: 40, lane: -15 },
    awayPivot: { dist: 270, lane: -15 },
    awayB1: { dist: 225, lane: -15 },
    awayB2: { dist: 180, lane: -15 },
    awayB3: { dist: 135, lane: -15 },
  };

  function easeInOutCubic(t: number): number {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function getTrackCoords(dist: number, lane: number) {
    if (!guidePathEl) return { x: 450, y: 390 };
    const s = ((dist % totalTrackLength) + totalTrackLength) % totalTrackLength;
    const pt = guidePathEl.getPointAtLength(s);
    const nextS = (s + 1) % totalTrackLength;
    const nextPt = guidePathEl.getPointAtLength(nextS);

    const tx = nextPt.x - pt.x;
    const ty = nextPt.y - pt.y;
    const len = Math.hypot(tx, ty) || 1;
    // Inward normal towards track infield in counter-clockwise flow
    const nx = ty / len;
    const ny = -tx / len;

    return {
      x: pt.x + nx * lane,
      y: pt.y + ny * lane,
    };
  }

  function updateSkaterElement(id: string, dist: number, lane: number) {
    const el = document.getElementById(id);
    if (!el) return;
    const coords = getTrackCoords(dist, lane);
    el.setAttribute('transform', `translate(${coords.x.toFixed(1)}, ${coords.y.toFixed(1)})`);
  }

  function animateToStep(targetIndex: number) {
    const fromIndex = currentStepIndex;
    currentStepIndex = targetIndex;
    const targetConfig = stepsConfig[targetIndex];

    // Cancel any active animation frame
    if (animFrameId) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }

    // 1. Update UI Elements immediately
    updateUI(targetConfig, targetIndex);

    // 2. Prepare animation targets
    // For smooth forward motion:
    // If going forward (or looping from 4 to 0), ensure skaters advance forward counter-clockwise
    const startStates: Record<SkaterKey, SkaterTrackState> = {} as any;
    const targetDistances: Record<SkaterKey, { dist: number; lane: number }> = {} as any;

    const isForward = targetIndex > fromIndex || (fromIndex === 4 && targetIndex === 0);
    const animDuration = targetIndex === 3 && fromIndex === 2 ? 1900 : 1300; // Smooth 1-lap scoring sprint

    (Object.keys(targetConfig.positions) as SkaterKey[]).forEach((key) => {
      const current = currentSkatersState[key];
      const target = targetConfig.positions[key];
      startStates[key] = { dist: current.dist, lane: current.lane };

      let targetD = target.dist;
      if (isForward) {
        // Find forward distance: normalize current to base loop, then ensure target >= current
        const currentMod = ((current.dist % totalTrackLength) + totalTrackLength) % totalTrackLength;
        let diff = targetD - currentMod;
        if (diff < 0) {
          diff += totalTrackLength;
        }
        targetDistances[key] = {
          dist: current.dist + diff,
          lane: target.lane,
        };
      } else {
        // Moving backward (e.g. clicking prev): take shortest direct distance
        const currentMod = ((current.dist % totalTrackLength) + totalTrackLength) % totalTrackLength;
        let diff = targetD - currentMod;
        if (diff > totalTrackLength / 2) diff -= totalTrackLength;
        if (diff < -totalTrackLength / 2) diff += totalTrackLength;
        targetDistances[key] = {
          dist: current.dist + diff,
          lane: target.lane,
        };
      }
    });

    // Score popups: render with smooth fade-in as jammers complete the scoring pass
    const popupsContainer = document.getElementById('vis-score-popups');
    if (popupsContainer) {
      popupsContainer.innerHTML = '';
      if (targetConfig.scoresToShow.length > 0) {
        targetConfig.scoresToShow.forEach((item, idx) => {
          const coords = getTrackCoords(item.dist, item.lane);
          const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          g.setAttribute('transform', `translate(${coords.x.toFixed(1)}, ${coords.y.toFixed(1)})`);
          g.setAttribute('opacity', '0');
          g.setAttribute('class', 'score-pop');
          const delayBase = targetIndex === 3 ? 0.9 : 0.4;
          g.style.transition = `opacity 0.35s ease-out ${delayBase + idx * 0.18}s`;

          const isAway = item.team === 'away';
          const textLength = item.text.length;
          // Dynamic width sizing so text NEVER outsizes the callout box:
          const badgeWidth = Math.max(74, textLength * 7.5 + 22);
          const badgeHeight = 22;

          const bg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          bg.setAttribute('x', String(-badgeWidth / 2));
          bg.setAttribute('y', String(-badgeHeight / 2));
          bg.setAttribute('width', String(badgeWidth));
          bg.setAttribute('height', String(badgeHeight));
          bg.setAttribute('rx', '11');
          bg.setAttribute('fill', isAway ? '#0284C7' : '#E5A93C');
          bg.setAttribute('stroke', isAway ? '#38BDF8' : '#FFFFFF');
          bg.setAttribute('stroke-width', '1.5');
          bg.setAttribute('filter', 'url(#skaterShadow)');

          const txt = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          txt.setAttribute('text-anchor', 'middle');
          txt.setAttribute('y', '4');
          txt.setAttribute('fill', isAway ? '#FFFFFF' : '#000000');
          txt.setAttribute('font-family', "'Bebas Neue', sans-serif");
          txt.setAttribute('font-size', '12');
          txt.setAttribute('letter-spacing', '0.5');
          txt.textContent = item.text;

          g.appendChild(bg);
          g.appendChild(txt);
          popupsContainer.appendChild(g);

          // Trigger opacity transition
          setTimeout(() => {
            g.setAttribute('opacity', '1');
          }, 50);
        });
      }
    }

    const startTime = performance.now();

    function stepAnimation(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / animDuration);
      const ease = easeInOutCubic(progress);

      (Object.keys(startStates) as SkaterKey[]).forEach((key) => {
        const start = startStates[key];
        const target = targetDistances[key];
        const currentDist = start.dist + (target.dist - start.dist) * ease;
        const currentLane = start.lane + (target.lane - start.lane) * ease;

        currentSkatersState[key].dist = currentDist;
        currentSkatersState[key].lane = currentLane;

        updateSkaterElement(skaterDomIds[key], currentDist, currentLane);
      });

      if (progress < 1) {
        animFrameId = requestAnimationFrame(stepAnimation);
      } else {
        animFrameId = null;
      }
    }

    animFrameId = requestAnimationFrame(stepAnimation);
  }

  function updateUI(data: StepConfig, index: number) {
    // 1. Update HUD
    const clockEl = document.getElementById('vis-hud-clock');
    const bardScoreEl = document.getElementById('vis-bard-score');
    const awayScoreEl = document.getElementById('vis-away-score');
    if (clockEl) clockEl.textContent = data.clock;
    if (bardScoreEl) bardScoreEl.textContent = String(data.bardScore);
    if (awayScoreEl) awayScoreEl.textContent = String(data.awayScore);

    // 2. Update Pills
    const pills = document.querySelectorAll('.step-pill');
    pills.forEach((pill, i) => {
      if (i === index) {
        pill.classList.add('active', 'border-[#541221]', 'bg-[#541221]/30', 'text-white');
        pill.classList.remove('border-[#2A2A2A]', 'bg-[#1B1B1B]', 'text-gray-400');
        pill.setAttribute('aria-selected', 'true');
      } else {
        pill.classList.remove('active', 'border-[#541221]', 'bg-[#541221]/30', 'text-white');
        pill.classList.add('border-[#2A2A2A]', 'bg-[#1B1B1B]', 'text-gray-400');
        pill.setAttribute('aria-selected', 'false');
      }
    });

    // 3. Update Progress Bar
    const progressBar = document.getElementById('vis-progress-bar');
    if (progressBar) {
      progressBar.style.width = `${((index + 1) / stepsConfig.length) * 100}%`;
    }

    // 4. Update Halos (Lead Jammer)
    const bardHalo = document.getElementById('halo-bard-jammer');
    const awayHalo = document.getElementById('halo-away-jammer');
    if (bardHalo) bardHalo.setAttribute('opacity', data.showLeadHalo === 'bard' ? '0.85' : '0');
    if (awayHalo) awayHalo.setAttribute('opacity', data.showLeadHalo === 'away' ? '0.85' : '0');

    // 5. Update Pack Bracket
    const bracketEl = document.getElementById('vis-pack-bracket');
    if (bracketEl) bracketEl.setAttribute('opacity', data.showPackBracket ? '1' : '0');

    // 6. Update Whistle Bubble
    const whistleBubble = document.getElementById('vis-whistle-bubble');
    const whistleBg = document.getElementById('vis-whistle-bg') as SVGRectElement | null;
    const whistleText = document.getElementById('vis-whistle-text') as SVGTextElement | null;
    if (whistleBubble && whistleText) {
      if (data.showWhistle) {
        whistleText.textContent = data.whistleText;
        let measuredWidth = 0;
        try {
          measuredWidth = whistleText.getComputedTextLength();
        } catch (e) {
          measuredWidth = data.whistleText.length * 10;
        }
        if (!measuredWidth || measuredWidth < 50) {
          measuredWidth = data.whistleText.length * 10;
        }
        const bubbleWidth = Math.max(260, Math.ceil(measuredWidth + 56));
        if (whistleBg) {
          whistleBg.setAttribute('x', String(-bubbleWidth / 2));
          whistleBg.setAttribute('width', String(bubbleWidth));
        }
        whistleBubble.setAttribute('opacity', '1');
        whistleBubble.setAttribute('transform', 'translate(450, 40) scale(1)');
      } else {
        whistleBubble.setAttribute('opacity', '0');
        whistleBubble.setAttribute('transform', 'translate(450, 40) scale(0.9)');
      }
    }

    // 7. Update Explanation Card
    const cardBadge = document.getElementById('vis-card-badge');
    const cardTitle = document.getElementById('vis-card-title');
    const cardDesc = document.getElementById('vis-card-description');
    const cardTip = document.getElementById('vis-card-spectator-tip');
    const cardTakeaway = document.getElementById('vis-card-takeaway');

    if (cardBadge) cardBadge.textContent = data.badge;
    if (cardTitle) cardTitle.textContent = data.title;
    if (cardDesc) cardDesc.innerHTML = data.description;
    if (cardTip) cardTip.textContent = data.spectatorTip;
    if (cardTakeaway) cardTakeaway.innerHTML = data.takeawayHtml;
  }

  function nextStep() {
    const nextIdx = (currentStepIndex + 1) % stepsConfig.length;
    animateToStep(nextIdx);
  }

  function prevStep() {
    const prevIdx = (currentStepIndex - 1 + stepsConfig.length) % stepsConfig.length;
    animateToStep(prevIdx);
  }

  function toggleAutoPlay() {
    isAutoPlaying = !isAutoPlaying;
    const playIcon = document.getElementById('vis-play-icon');
    const pauseIcon = document.getElementById('vis-pause-icon');
    const playText = document.getElementById('vis-play-text');

    if (isAutoPlaying) {
      if (playIcon) playIcon.classList.add('hidden');
      if (pauseIcon) pauseIcon.classList.remove('hidden');
      if (playText) playText.textContent = 'Pause';
      autoPlayTimer = window.setInterval(nextStep, STEP_AUTO_DELAY);
    } else {
      if (playIcon) playIcon.classList.remove('hidden');
      if (pauseIcon) pauseIcon.classList.add('hidden');
      if (playText) playText.textContent = 'Auto-Play';
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }
  }

  function initVisualizer() {
    guidePathEl = document.getElementById('trackGuidePath') as SVGPathElement | null;
    if (guidePathEl) {
      totalTrackLength = guidePathEl.getTotalLength() || 1702;
    }

    // Attach Step Pills Click
    const pills = document.querySelectorAll('.step-pill');
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const stepNum = parseInt(pill.getAttribute('data-step') || '1', 10);
        if (isAutoPlaying) toggleAutoPlay();
        animateToStep(stepNum - 1);
      });
    });

    // Prev / Next buttons
    const prevBtn = document.getElementById('vis-prev-btn');
    const nextBtn = document.getElementById('vis-next-btn');
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (isAutoPlaying) toggleAutoPlay();
        prevStep();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (isAutoPlaying) toggleAutoPlay();
        nextStep();
      });
    }

    // Play / Pause toggle
    const playBtn = document.getElementById('vis-play-toggle');
    if (playBtn) {
      playBtn.addEventListener('click', toggleAutoPlay);
    }

    // Initial positioning
    const initialConfig = stepsConfig[0];
    (Object.keys(initialConfig.positions) as SkaterKey[]).forEach((key) => {
      const pos = initialConfig.positions[key];
      currentSkatersState[key] = { dist: pos.dist, lane: pos.lane };
      updateSkaterElement(skaterDomIds[key], pos.dist, pos.lane);
    });

    updateUI(initialConfig, 0);
  }

  // Handle standard page loads or Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVisualizer);
  } else {
    initVisualizer();
  }
  document.addEventListener('astro:page-load', initVisualizer);
</script>

