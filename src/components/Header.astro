---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.jpg';

const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/schedule', label: 'Schedule & Bouts' },
  { href: '/roster', label: 'Roster' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/join', label: 'Join / Fresh Meat' },
];
---

<header class="bg-[#121212] border-b border-[#2A2A2A] sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo -->
      <a href="/" class="flex items-center gap-3.5 group">
        <div class="w-12 h-12 bg-white rounded-full p-1 flex items-center justify-center border-2 border-white shadow-sm transition-transform group-hover:scale-105">
          <Image 
            src={logoImage} 
            alt="Brookings Area Roller Derby Logo" 
            class="w-full h-full object-contain" 
          />
        </div>
        <div class="flex flex-col">
          <span class="font-heading text-2xl sm:text-3xl text-white tracking-wide uppercase leading-none group-hover:text-red-500 transition-colors">
            Brookings Area Roller Derby
          </span>
          <span class="text-[11px] font-sans font-semibold tracking-wider uppercase text-gray-400">
            South Dakota Flat-Track Derby • BARD
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a 
              href={link.href} 
              class={`px-3.5 py-2 font-heading text-lg tracking-wider uppercase rounded-md transition-colors ${
                isActive 
                  ? 'text-white bg-[#541221] font-bold' 
                  : 'text-gray-300 hover:text-white hover:bg-[#1F1F1F]'
              }`}
            >
              {link.label}
            </a>
          );
        })}
        
        <a 
          href="/schedule" 
          class="ml-3 px-5 py-2 bg-[#541221] hover:bg-[#7A1A30] text-white font-heading text-lg uppercase tracking-wider rounded-md border border-[#9E1F3D] transition-colors shadow-sm"
        >
          Tickets
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2 rounded-md text-gray-300 hover:text-white hover:bg-[#1F1F1F] focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile dropdown menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#181818] border-b border-[#2A2A2A] px-4 pt-3 pb-6 space-y-1">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href;
      return (
        <a 
          href={link.href} 
          class={`block px-3 py-2.5 rounded font-heading text-xl uppercase tracking-wider ${
            isActive ? 'bg-[#541221] text-white' : 'text-gray-300 hover:bg-[#252525] hover:text-white'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <a 
      href="/schedule" 
      class="block mt-4 text-center py-3 bg-[#541221] text-white font-heading text-xl uppercase tracking-wider rounded"
    >
      Tickets &amp; Bout Dates
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
