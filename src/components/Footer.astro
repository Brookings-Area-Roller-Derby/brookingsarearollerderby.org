---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.jpg';
import { siteConfig } from '../config/site';
---

<footer class="bg-[#0B0B0B] text-gray-400 border-t-4 border-[#541221] mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- League & 501(c)(3) Notice -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <Image
            src={logoImage}
            alt="Brookings Area Roller Derby Logo"
            class="w-12 h-12 rounded-full bg-white p-1 object-contain"
          />
          <h3 class="font-heading text-2xl text-white tracking-wider uppercase">
            Brookings Area Roller Derby
          </h3>
        </div>
        <p class="text-sm leading-relaxed text-gray-300 max-w-md">
          Brookings Area Roller Derby (BARD) is an inclusive, skater-owned non-profit sports
          organization dedicated to athletic excellence, community empowerment, and full-contact
          flat-track roller derby. Serving Eastern South Dakota since 2013, formerly skating as the
          Midwest Maidens.
        </p>
        <div class="p-3 bg-[#1B1B1B] border-l-2 border-[#E5A93C] text-xs text-gray-400">
          <strong class="text-white block uppercase tracking-wide mb-0.5">Non-Profit Status:</strong
          >
          BARD is organized as a community non-profit 501(c)(3) organization. Donations and sponsorships
          are tax-deductible to the extent allowed by law.
          <div class="pt-2">
            <a
              href={siteConfig.donationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#E5A93C] hover:underline font-bold inline-flex items-center gap-1"
            >
              Donate via Venmo Charity &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4
          class="font-heading text-xl text-white uppercase tracking-wider mb-4 border-b border-[#3B0B16] pb-1"
        >
          Explore
        </h4>
        <ul class="space-y-2 text-sm font-medium">
          <li><a href="/" class="hover:text-[#E5A93C] transition-colors">Home</a></li>
          <li>
            <a href="/schedule" class="hover:text-[#E5A93C] transition-colors"
              >{siteConfig.season} Season Schedule</a
            >
          </li>
          <li>
            <a href="/derby-101" class="hover:text-[#E5A93C] transition-colors">Derby 101 Guide</a>
          </li>
          <li>
            <a href="/roster" class="hover:text-[#E5A93C] transition-colors">Skater Roster</a>
          </li>
          <li>
            <a href="/sponsors" class="hover:text-[#E5A93C] transition-colors">Sponsorship Tiers</a>
          </li>
          <li>
            <a href="/join" class="hover:text-[#E5A93C] transition-colors">Join the League</a>
          </li>
          <li>
            <a
              href={siteConfig.donationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#E5A93C] hover:underline">Donate (Venmo Charity)</a
            >
          </li>
          <li>
            <a
              href={siteConfig.merchUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-red-400 hover:text-red-300 font-bold inline-flex items-center gap-1"
              >Merch (Bonfire) &rarr;</a
            >
          </li>
        </ul>
      </div>

      <!-- Connect & Venue -->
      <div>
        <h4
          class="font-heading text-xl text-white uppercase tracking-wider mb-4 border-b border-[#3B0B16] pb-1"
        >
          Home Track & Connect
        </h4>
        <p class="text-sm text-gray-300 mb-2">
          <strong class="text-white block">Home Arena:</strong>
          {siteConfig.homeVenue.name}<br />
          {siteConfig.homeVenue.address}
        </p>
        <p class="text-xs text-gray-300 mb-3">
          <strong class="text-white block">General Inquiries & Sponsorships:</strong>
          <a href={`mailto:${siteConfig.email}`} class="text-[#E5A93C] hover:underline break-all">
            {siteConfig.email}
          </a>
        </p>

        <!-- Social Icons -->
        <div class="space-y-2 pt-1">
          <div class="flex flex-wrap items-center gap-2">
            <a
              href={siteConfig.facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1F1F1F] hover:bg-[#541221] text-gray-300 hover:text-white text-xs font-heading uppercase tracking-wider rounded transition-colors border border-[#333]"
              title="Follow BARD on Facebook"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path
                  d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.582 9 4.615V8z"
                ></path>
              </svg>
              Facebook
            </a>
            <a
              href={siteConfig.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1F1F1F] hover:bg-[#541221] text-gray-300 hover:text-white text-xs font-heading uppercase tracking-wider rounded transition-colors border border-[#333]"
              title="Follow BARD on Instagram"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
              Instagram
            </a>
            <a
              href={siteConfig.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1F1F1F] hover:bg-[#541221] text-gray-300 hover:text-white text-xs font-heading uppercase tracking-wider rounded transition-colors border border-[#333]"
              title="Subscribe to BARD on YouTube"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path
                  d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                ></path>
              </svg>
              YouTube
            </a>
            <a
              href={siteConfig.tiktokUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1F1F1F] hover:bg-[#541221] text-gray-300 hover:text-white text-xs font-heading uppercase tracking-wider rounded transition-colors border border-[#333]"
              title="Follow BARD on TikTok"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path
                  d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
                ></path>
              </svg>
              TikTok
            </a>
          </div>

          <div class="pt-2">
            <a
              href={siteConfig.merchUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-[#541221] hover:bg-[#7A1A30] text-white text-xs font-heading uppercase tracking-wider rounded transition-colors border border-[#9E1F3D] shadow-sm"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
              </svg>
              Official Bonfire Merch &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-12 pt-6 border-t border-[#1B1B1B] text-center text-xs text-gray-400 flex flex-col sm:flex-row justify-between items-center gap-4"
    >
      <p>
        &copy; {new Date().getFullYear()}
        {siteConfig.name} ({siteConfig.shortName}). All rights reserved.
      </p>
      <p class="text-gray-400">Skater Owned &amp; Operated • Brookings, South Dakota</p>
    </div>
  </div>
</footer>
